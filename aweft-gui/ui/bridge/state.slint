// Slint-Rust 桥接层：状态管理
// Rust 侧通过 set_xxx 更新这些状态
import {
    SlintAudioTrack,
    SlintSubtitleRow,
    SlintTimelineSubBlock,
    SlintVideoPos,
    SlintVideoTimeBar,
} from "../core/types.slint";
import { GraphLink, GraphNode } from "../areas/node_graph/node_frame.slint";
import { ContextMenuItem, MenuRect } from "../widgets/context_menu.slint";
import {
    SlintFCurveChannel,
    SlintCurveSegment,
    SlintHandleMarker,
    SlintDopeConnection,
    SlintSummaryKeyframe,
    SlintExtrapolation,
    SlintNlaTrack,
    SlintInterpolationState,
} from "../core/animation_types.slint";
import {
    SplitPreviewOverlayData,
} from "../screen/overlays/split_preview.slint";
import {
    JoinHighlightOverlayData,
} from "../screen/overlays/join_highlight.slint";
import {
    CloseAreaOverlayData,
} from "../screen/overlays/close_area.slint";

export global VideoState {
    // 每个会话的最新视频帧（首帧到来前为空图）
    in property <[image]> video-frames: [];
    // 每个会话的视频尺寸（0 = 尚未收到首帧，视口用默认占位尺寸）
    in property <[int]> video-widths: [];
    in property <[int]> video-heights: [];
    // 每个会话的视口世界坐标位置（相对主视频世界矩形左上角）
    in property <[SlintVideoPos]> video-positions: [];
    // 每个会话的控制时间条（各面板 TimeRuler 叠加显示，点击选中/拖拽 seek）
    in property <[SlintVideoTimeBar]> time-bars: [];
    // 当前选中视频下标（-1 = 无选中）
    in property <int> selected-video: -1;
    // 主视频下标（唯一带矩形参考线）
    in property <int> main-video: -1;
    // 播放状态（时间线 Header 播放/暂停按钮图标）
    in property <bool> playing: false;
}

export global AudioState {
    // 每个视频会话的音频轨（外层下标 = 视频下标；内层 = 该容器内的音轨）。
    // 与 VideoState.time-bars 平行，不再嵌在时间条行内。
    in property <[[SlintAudioTrack]]> audio-tracks: [];
    // 每个视频会话当前实时播放的音轨下标（-1 = 未选/默认首轨）
    in property <[int]> playback-tracks: [];
}

// 通用「点击孔外即收起」遮罩状态：MainWindow 顶层挂一份差集遮罩（见
// widgets/dismiss_overlay.slint），挖去浮层自身占用的窗口矩形，点击其余任意处即收起。
// 当前两类使用方：内嵌输入框聚焦（搜索框、节点图改名框）与右键/下拉菜单打开。
// 同一时刻只有一个使用方持有它；坐标均为相对 MainWindow 的逻辑坐标。
export global DismissOverlayState {
    in-out property <bool> active: false;
    in-out property <length> hole-x: 0px;
    in-out property <length> hole-y: 0px;
    in-out property <length> hole-width: 0px;
    in-out property <length> hole-height: 0px;

    // 以 rect 挖孔并显示遮罩
    public function show(rect: MenuRect) {
        hole-x = rect.x;
        hole-y = rect.y;
        hole-width = rect.width;
        hole-height = rect.height;
        active = true;
    }

    // 收起遮罩：使用方消失时必须调用，否则遮罩一直盖住整个窗口
    public function hide() {
        active = false;
    }
}

export global SubtitleState {
    in property <image> current-subtitle-frame;
    in property <[SlintSubtitleRow]> rows: [];
    // 时间线根级收起时显示的"全部字幕行片段块"（Rust 侧全量事件模型；
    // 与分组收起显示的 child-blocks 共用同一渲染组件）
    in property <[SlintTimelineSubBlock]> timeline-root-blocks: [];
}

// 节点图编辑器状态：样式图/应用图各一组模型，由 Rust 侧驱动。
// 节点/连线模型为 Rust 持有的 VecModel（增删节点重建、拖动节点局部更新）。
export global NodeGraphState {
    // 样式图：链列表 / 当前链索引 / 节点 / 连线 / 右键菜单项
    in property <[ContextMenuItem]> style-chain-items: [];
    in property <int> style-current-chain: 0;
    in property <[GraphNode]> style-nodes: [];
    in property <[GraphLink]> style-links: [];
    in property <[ContextMenuItem]> style-menu-items: [];
    // 应用图
    in property <[ContextMenuItem]> app-chain-items: [];
    in property <int> app-current-chain: 0;
    in property <[GraphNode]> app-nodes: [];
    in property <[GraphLink]> app-links: [];
    in property <[ContextMenuItem]> app-menu-items: [];
}

/// 动画编辑器状态：曲线编辑器（Graph Editor）/ 摄影表（Dope Sheet）共用数据，
/// 由 Rust 侧驱动。通道/关键帧模型为 Rust 持有的 VecModel。
export global AnimationState {
    // 曲线编辑器
    in property <[SlintFCurveChannel]> channels: [];
    // 曲线编辑器 / 摄影表各自的过滤压缩视图（Rust FilterModel，按各自搜索词过滤）
    in property <[SlintFCurveChannel]> graph-channels: [];
    in property <[SlintFCurveChannel]> dope-channels: [];
    // 曲线编辑器画布：只含匹配搜索通道的段/手柄（FilterModel）
    in property <[SlintCurveSegment]> graph-segments: [];
    in property <[SlintHandleMarker]> graph-handles: [];
    in property <[SlintCurveSegment]> segments: [];
    in property <[SlintHandleMarker]> handles: [];
    // 摄影表：线性/常量插值段的连接线（扁平模型，Rust 派生）
    in property <[SlintDopeConnection]> dope-connections: [];
    // 摄影表：汇总条带关键帧（按整数毫秒时间聚合所有通道，Rust 派生）
    in property <[SlintSummaryKeyframe]> dope-summary-keyframes: [];
    // 每通道排序后首/末关键帧（外推线数据源，Rust 投影派生）
    in property <[SlintExtrapolation]> extrapolations: [];
    // NLA 编辑器
    in property <[SlintNlaTrack]> nla-tracks: [];
    // 共享：当前时间（播放头）
    in property <float> current-time: 0.0;
    // 当前 Action 名称（header 栏中区显示）
    in property <string> action-name: "";
    // Action 选择下拉菜单项（摄影表 Header 中区）
    in property <[ContextMenuItem]> action-items: [];
    // 当前选中的 Action 下标（-1 = 无）
    in property <int> current-action: 0;
    // 共享：Action 时长范围（画布上用于明暗分段，时长内亮 / 时长外暗）
    in property <float> action-start: 0.0;
    in property <float> action-end: 0.0;
    // 共享：当前激活通道（-1 = 无激活；侧边栏判断当前是哪一条曲线）
    in property <int> current-channel: -1;
    // 通道选中**显示**掩码（Rust 即时同步）：与 channels 模型的 selected 字段解耦——
    // 后者因嵌套在关键帧 repeater 内、拖拽中更新会破坏 grab，故延迟到 released 写回；
    // 此掩码是独立模型，按下/选择即更新，曲线高亮读它（"显示先动"）。
    in property <[bool]> selected-channels: [];
    // 侧边栏：选中关键帧数量（0 = 未选中关键帧，插值面板禁用）
    in property <int> selected-keyframes: 0;
    // 选中关键帧的插值聚合状态（供侧边栏显示）
    in property <SlintInterpolationState> selected-interpolation: SlintInterpolationState.none;
    // 手柄拖拽时相邻软钳制的有效控制点预览（拖拽上下文依赖，投影填充/清空）
    in property <[SlintHandleMarker]> preview-handles: [];
}

/// 拖拽预览覆盖层状态（UI 自持有的临时交互数据）。
/// 由拖拽事件直接写入，不经 store/depsgraph。
export global OverlayState {
    in property <bool> show-split-preview-overlay: false;
    in property <SplitPreviewOverlayData> split-preview-overlay-data;
    in property <bool> show-join-highlight-overlay: false;
    in property <JoinHighlightOverlayData> join-highlight-overlay-data;
    in property <bool> show-close-area-overlays: false;
    in property <[CloseAreaOverlayData]> close-area-overlay-datas;
}

// 媒体选择器状态（仅 Android 用：MediaStore 查库后由 Rust 填行、弹层；
// 桌面走 rfd 原生对话框，用不到它，但 global 与桌面共存无害）。
export global MediaPickerState {
    // 弹层是否可见
    in property <bool> visible: false;
    // 待选行文案（Rust 按 "名 · 时长 · 大小" 拼好，下标与 Rust 侧条目一一对应）
    in property <[string]> items: [];
}

// 协作面板展示状态（UI 先行占位：字段由 Rust 后续接入 aweft-collab 后驱动）。
export global CollabUiState {
    // 连接状态文案（如"未连接"/"已连接"）
    in property <string> status-text: "未连接";
    // 在线成员数（含本机）
    in property <int> peer-count: 0;
    // 当前会话名（"" = 未加入会话）
    in property <string> session-name: "";
    // 本机成员 id（"" = 未初始化）
    in property <string> member-id: "";
    // 成员 id 列表
    in property <[string]> members: [];
}

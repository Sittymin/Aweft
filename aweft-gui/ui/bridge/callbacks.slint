import {
    SlintKey,
    ActionZoneCorner,
    SlintAreaType,
    SlintSubtitleRow,
    SlintWaveformBucket,
    GraphType,
    SlintSelectionModifier,
} from "../core/types.slint";
import {
    SlintKeyframeDragMode,
    SlintHandleDragMode,
    SlintColorMode,
    SlintInterpolation,
} from "../core/animation_types.slint";
import { NodeSocketType, SocketHit } from "../areas/node_graph/node_frame.slint";

export global DragCallbacks {
    callback actionzone-drag(area-key: SlintKey, corner: ActionZoneCorner, offset-x: length, offset-y: length);
    callback actionzone-drag-end(area-key: SlintKey, is-cancel: bool);
    callback edge-drag(vert-keys: [SlintKey], offset-x: length, offset-y: length);
    callback edge-drag-end(is-cancel: bool);
}

export global AreaCallbacks {
    callback switch-area-type(area-key: SlintKey, area-type: SlintAreaType);
}

// 视口回调：打开视频等媒体操作（Rust 侧处理）
export global VideoCallbacks {
    // 打开/追加一个视频（首个自动成为主视频）
    callback open-video();
    // 播放/暂停切换（时间线 Header 播放按钮）
    callback toggle-playback();
    // 点击视口视频 / 控制时间条选中视频（-1 = 取消选中）
    callback select-video(video-index: int, modifier: SlintSelectionModifier);
    // 控制时间条按下：Shift 批量拖拽选择集合，否则只拖拽当前视频
    callback time-bar-pressed(video-index: int, is-batch: bool);
    // 控制时间条拖拽：seek 当前选中视频（无选中则主视频）到指定秒
    callback time-bar-dragged(time: float);
    // 控制时间条拖拽结束：松手，暂停预览回落暂停态
    callback time-bar-released(video-index: int);
    // 音频波形标尺定位指定视频，不改变全局视口选择。
    callback seek-video(video-index: int, time: float);
    // 右键非主视频"设为主视频"
    callback set-main-video(video-index: int);
    // 右键任意视频"更换视频"：重新选择文件原地替换
    callback replace-video(video-index: int);
    // 切换指定视频音频静音状态
    callback toggle-mute-video(video-index: int);
    // 视口点击命中检测：返回该点应选中的视频下标（重叠时按选中顺序循环），-1 无
    callback video-picked(x: float, y: float) -> int;
    // 拖拽移动非主视频到指定世界坐标
    callback video-moved(video-index: int, x: float, y: float);
    // 视口命中检测：返回该点最上层的视频下标（拖拽移动起点/右键菜单目标），-1 无
    callback video-hit-top(x: float, y: float) -> int;
}

// 音频回调：音轨选择与视图上报（Rust 侧处理）。
// 波形后台批次经 Rust 通道直写基础桶模型，不经过 Slint 回调（见 store/audio.rs）。
// 视图上报返回该 Area 的持久列模型（标识恒定，Slint 侧不重建槽位）：bucket-ms
// 为列宽（秒），first/count 为列窗口；上报同时登记视图，pump 据此重算新批次。
export global AudioCallbacks {
    // 波形 Area 选择音轨（各 Area 本地 tracks/track-index 自持，仅通知 Rust 侧）
    callback select-audio-track(video-index: int, track-index: int);
    // 上报可视窗口并取持久列模型：聚合基础桶，结果恒与覆盖区间精确对应。
    // pure：返回值仅由参数与基础模型决定（Rust 侧持久化是备忘实现），可进绑定；
    // 重复求值写相同内容，幂等。
    pure callback waveform-view(area-key: SlintKey, video-index: int, track-index: int, bucket-ms: float, first: int, count: int) -> [SlintWaveformBucket];
}

export global SequenceCallbacks {
    callback toggle-group-collapsed(group-id: string);
    callback increment-timecode(item-id: string, is-start-time: bool, is_batch: bool);
    callback decrement-timecode(item-id: string, is-start-time: bool, is_batch: bool);
    callback drag-timecode-preview(item-id: string, is-start-time: bool, delta-x: length, is_batch: bool);
    callback drag-timecode-commit(item-id: string, is-start-time: bool, delta-x: length, is_batch: bool);
    callback drag-timecode-cancel(item-id: string, is-start-time: bool, is_batch: bool);
    callback timecode-input(item-id: string, is-start-time: bool, text: string, is_batch: bool);
    // 行选择（none=普通单选，shift=区间扩展，ctrl=切换）
    callback select-row(item-id: string, modifier: SlintSelectionModifier);
    // 时间线画布框选（时间范围 × 行区间；none=替换，shift=加选，ctrl=切换）
    callback timeline-marquee-select(x-lo: float, x-hi: float, row-lo: int, row-hi: int, modifier: SlintSelectionModifier);
    // 画布空白点击：清除选中
    callback timeline-deselect-all();
    // 时间线片段整体拖动（delta-x 世界时间秒）：预览不写数据（行编辑器与时间线
    // 块由同一预览 Tag 一并驱动），松开提交，右键取消恢复
    callback timeline-block-dragged(item-id: string, delta-x: float);
    callback timeline-block-drag-commit(item-id: string, delta-x: float);
    callback timeline-block-drag-cancel(item-id: string);
    // 右键菜单
    // NOTE: 后续在空列表当中的也需要实现（即无法获得开始与结束时间）
    // 参数用于定位新增的行位置
    callback add-line(item-id: string, start-time: string, end_time: string,
        // FIXME: 或许应该使用 enum，会有一个默认 Actor
        // actor: Option<ActorId>,
        text: string,
        // TODO: 这个分片的类型设计需要考虑
        // segment_timing:
        // TODO: 样式链的类型设计也需要考虑
        // style:
    );
    callback add-group(item-id: string);
    // 应用范围是选中的行
    callback cut-items();
    callback copy-items();
    callback paste-items(anchor-item-id: string);
    callback delete-selected-items();

    callback ungroups(group-item-id: string);
}

// 节点图编辑回调：编辑器只做渲染与拖拽瞬态，全部图数据操作走 Rust。
export global NodeGraphCallbacks {
    // 端口命中（本地坐标，相对节点左上角，逻辑像素）：返回 sockets 组合数组下标，-1 无。
    // 由 Rust 统一命中（与 find-drop-socket 同源），消除 Slint 硬编码端口数上限。
    callback socket-at(graph-type: GraphType, node-index: int, x: length, y: length) -> int;
    // 拖动节点：上报新的世界坐标（UI 位置数据，不改图结构）
    callback node-dragged(graph-type: GraphType, node-index: int, x: length, y: length);
    // 在右键位置添加节点，返回新节点在 nodes 模型中的下标
    callback add-node(graph-type: GraphType, template-index: int, x: length, y: length) -> int;
    // 删除节点（Rust 一并断开相关连线并重建模型）
    callback delete-node(graph-type: GraphType, node-index: int);
    // 拖输入端时，找喂给该输入端的那条连线（模型下标，-1 无）；用于拖拽时隐藏它
    callback find-link-for-input(graph-type: GraphType, node-index: int, socket-index: int) -> int;
    // 找拖拽释放位置命中的、类型匹配的输入端口（世界坐标）
    callback find-drop-socket(graph-type: GraphType, x: length, y: length, data-type: NodeSocketType) -> SocketHit;
    // 端口拖拽松开：由 Rust 按拖拽语义完成断开/重连（node/socket 为被拖的端口）
    callback socket-drag-ended(graph-type: GraphType, node-index: int, socket-index: int, is-input: bool, x: length, y: length);
    // 切换/新建链：加载第 index 条链到编辑器模型
    callback load-chain(graph-type: GraphType, index: int);
    // 新建一条默认链并切换到它，返回新链在切换菜单中的下标
    callback new-chain(graph-type: GraphType) -> int;
    // 样式引用节点下拉菜单选择样式链（node-index 为节点下标，menu-index 为样式链菜单下标）
    callback menu-selected(graph-type: GraphType, node-index: int, menu-index: int);
    // 端口预设下拉选择（socket-row 为端口全局行号，option-index 为预设下标）
    callback socket-option-selected(graph-type: GraphType, node-index: int, socket-row: int, option-index: int);
    // 角色下拉"新建角色"：创建新角色并设端口默认值
    callback create-actor(graph-type: GraphType, node-index: int, socket-row: int, name: string);
    // 内嵌文本输入框提交（字符串常量）：设端口默认值
    callback socket-input-changed(graph-type: GraphType, node-index: int, socket-row: int, text: string);
}

// 动画编辑器（曲线编辑器 + 摄影表 + NLA）回调：编辑器只做渲染与拖拽瞬态，
// 全部数据操作走 Rust（dispatch → depsgraph 投影）。
export global AnimationCallbacks {
    // —— 曲线编辑器：关键帧 ——
    // 按下：none=单选，shift=区间扩展，ctrl=切换
    callback keyframe-pressed(curve-index: int, key-index: int, modifier: SlintSelectionModifier);
    // 拖拽移动（delta 相对按下起点，世界坐标）
    callback keyframe-dragged(curve-index: int, key-index: int, delta-time: float, delta-value: float, mode: SlintKeyframeDragMode);
    // 松开：moved=false（单击）时折叠为单选
    callback keyframe-released(curve-index: int, key-index: int, moved: bool);
    // 画布空白点击：清除关键帧选中
    callback keyframe-deselect-all();
    // 拖动中右键取消：丢弃预览（与 NLA/字幕行一致）
    callback drag-cancel();
    // —— 曲线编辑器：贝塞尔控制柄 ——
    // 按下：none=单选，shift=区间扩展，ctrl=切换
    callback handle-pressed(curve-index: int, key-index: int, is-in: bool, modifier: SlintSelectionModifier);
    // 手柄拖拽约束模式：free=Ctrl，aligned=默认，symmetric=Shift
    callback handle-dragged(curve-index: int, key-index: int, is-in: bool, delta-time: float, delta-value: float, mode: SlintHandleDragMode);
    // 松开：moved=false（单击）时折叠为单选该手柄
    callback handle-released(curve-index: int, key-index: int, is-in: bool, moved: bool);
    // 画布空白框选（none=替换，shift=区间扩展，ctrl=切换）
    callback graph-marquee-select(x-lo: float, x-hi: float, y-lo: float, y-hi: float, modifier: SlintSelectionModifier);
    // —— 曲线编辑器：通道 ——
    // 通道/曲线按下：none=普通，shift=区间，ctrl=切换
    callback channel-pressed(curve-index: int, modifier: SlintSelectionModifier);
    // 画布空白点击：清除激活通道与选中
    callback channel-deselect-all();
    // 左侧搜索框：曲线编辑器 / 摄影表各自独立过滤（空串恢复全部）
    callback graph-search-changed(text: string);
    callback dope-search-changed(text: string);
    // 摄影表压缩视图中的一行被点击（显示行 → Rust 映射回真实通道）
    callback dope-channel-pressed(view-row: int, modifier: SlintSelectionModifier);
    // 侧边栏：设置曲线颜色来源（0=自动彩虹，1=用户设置）
    callback curve-color-mode-changed(curve-index: int, mode: SlintColorMode);
    // 侧边栏：设置选中关键帧的插值类型（0=贝塞尔，1=线性，2=常量）
    callback keyframe-interpolation-changed(interp: SlintInterpolation);
    callback channel-toggle-visible(curve-index: int);
    callback channel-toggle-modifier(curve-index: int);
    callback channel-toggle-active(curve-index: int);
    callback channel-toggle-editable(curve-index: int);
    // —— 摄影表（Dope Sheet）：关键帧（共用曲线编辑器的选中/数据，拖拽只调时间） ——
    callback dope-keyframe-pressed(curve-index: int, key-index: int, modifier: SlintSelectionModifier);
    callback dope-keyframe-dragged(curve-index: int, key-index: int, delta-time: float);
    callback dope-keyframe-released(curve-index: int, key-index: int, moved: bool);
    callback dope-keyframe-deselect-all();
    // 空白处框选（世界时间范围 + 行区间；mode 0=替换 1/2=追加）
    callback dope-marquee-select(x-lo: float, x-hi: float, row-lo: int, row-hi: int, modifier: SlintSelectionModifier);
    // —— 摄影表：汇总条带（聚合所有通道同一时刻的关键帧；拖拽跨通道同步移动） ——
    callback dope-summary-pressed(index: int, modifier: SlintSelectionModifier);
    callback dope-summary-dragged(index: int, delta-time: float);
    callback dope-summary-released(index: int, moved: bool);
    // —— NLA 编辑器：片断 ——
    // 按下：none=单选，shift/ctrl=追加切换；同时记录拖拽起点
    callback nla-strip-pressed(track-index: int, strip-index: int, modifier: SlintSelectionModifier);
    // 拖拽移动（delta-x 世界时间位移，delta-row 行数；锚点由 pressed 会话持有）
    callback nla-strip-dragged(delta-x: float, delta-row: float);
    // 松开：拖拽结束（数据层整理 + 写回 model；锚点由 pressed 会话持有）
    callback nla-strip-released();
    // 拖动中右键取消：丢弃预览（与字幕行时间拖动取消一致）
    callback nla-strip-drag-cancel();
    // 画布空白点击：清除全部片断选中
    callback nla-strip-deselect-all();
    // 画布级 TouchArea 左键命中检测（世界时间 x + 过滤视图行号）：命中返回编码
    // （track*10000+strip），并完成选中与拖拽会话记录；未命中返回 -1
    callback nla-strip-pick(x: float, row: int, modifier: SlintSelectionModifier) -> int;
    // 画布空白框选（时间范围 × 轨道区间；none=替换，shift=加选，ctrl=切换）
    callback nla-marquee-select(x-lo: float, x-hi: float, row-lo: int, row-hi: int, modifier: SlintSelectionModifier);
    // —— NLA 编辑器：轨道 ——
    // 轨道启用开关（enabled ↔ model NlaTrack.muted）
    callback nla-track-toggle-enabled(track-index: int);
    // 轨道锁定开关（纯 UI 态；锁定轨道不能编辑）
    callback nla-track-toggle-locked(track-index: int);
    // 全局 Action 轨：把当前编辑的 Action 作为片断向下插入 NLA（自动找能容纳的轨道）
    callback nla-track-push-down();
    // 轨道列表搜索（空 = 全部）
    callback nla-search-changed(text: string);
    // —— 共享：当前时间（播放头） ——
    callback set-current-time(time: float);
    // —— 摄影表 Header：Action 选择下拉菜单 ——
    callback action-selected(index: int);
    // —— 共享：视图缩放变化 —— 更新命中检测容差依据（刻度已 Slint 侧即时计算）
    callback view-changed(zoom-x: float, zoom-y: float);
}

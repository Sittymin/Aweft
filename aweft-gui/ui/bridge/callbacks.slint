import {
    SlintKey,
    ActionZoneCorner,
    SlintAreaType,
    SlintSubtitleRow,
} from "../core/types.slint";

export global DragCallbacks {
    callback actionzone-drag(area-key: SlintKey, corner: ActionZoneCorner, offset-x: length, offset-y: length);
    callback actionzone-drag-end(area-key: SlintKey, is-cancel: bool);
    callback edge-drag(vert-keys: [SlintKey], offset-x: length, offset-y: length);
    callback edge-drag-end(is-cancel: bool);
}

export global AreaCallbacks {
    callback switch-area-type(area-key: SlintKey, area-type: SlintAreaType);
}

export global LineEditorCallbacks {
    callback toggle-group-collapsed(group-id: string);
    callback increment-timecode(item-id: string, is-start-time: bool, is_batch: bool);
    callback decrement-timecode(item-id: string, is-start-time: bool, is_batch: bool);
    callback drag-timecode-preview(item-id: string, is-start-time: bool, delta-x: length, is_batch: bool);
    callback drag-timecode-commit(item-id: string, is-start-time: bool, delta-x: length, is_batch: bool);
    callback drag-timecode-cancel(item-id: string, is-start-time: bool, is_batch: bool);
    callback timecode-input(item-id: string, is-start-time: bool, text: string);
    // 行选择
    callback select-single(item-id: string);
    callback select-range(item-id: string);
    callback select-toggle(item-id: string);
    // 右键菜单
    // 参数用于定位新增的行位置
    callback add-line(item-id: string, start-time: string, end_time: string,
        // FIXME: 或许应该使用 enum，会有一个默认 Actor
        // actor: Option<ActorId>,
        text: string,
        // TODO: 这个分片的类型设计需要考虑
        // segment_timing: 
        // TODO: 样式链的类型设计也需要考虑
        // style: 
    );
    callback add-group(item-id: string);
    // 应用范围是选中的行
    callback copy-items();
    callback cut-items();
    callback paste-items(item-id: string);
    callback delete-selected-items();
    callback move-items-up();
    callback move-items-down();
    callback ungroups();
}

export struct SplitPreviewOverlayData {
    x1: length,
    y1: length,
    width1: length,
    height1: length,
    x2: length,
    y2: length,
    width2: length,
    height2: length,
}
export component SplitPreviewOverlay inherits Rectangle {
    in property <SplitPreviewOverlayData> data;

    Rectangle {
        x: data.x1;
        y: data.y1;
        width: data.width1;
        height: data.height1;
        border-color: rgba(1.0, 1.0, 1.0, 0.4);
        border-width: parent.border-width;
        // background: rgba(1.0, 1.0, 1.0, 0.10);
        background: red;
        z: 200;
    }

    Rectangle {
        x: data.x2;
        y: data.y2;
        width: data.width2;
        height: data.height2;
        border-color: blue;
        border-width: parent.border-width;
        background: rgba(1.0, 1.0, 1.0, 0.10);
        z: 200;
    }
}

export struct JoinHighlightOverlayData {
    x: length,
    y: length,
    width: length,
    height: length,
}

export component JoinHighlightOverlay inherits Rectangle {
    in property <JoinHighlightOverlayData> data;
    border-color: rgba(1.0, 1.0, 1.0, 0.4);
    background: red;
    x: data.x;
    y: data.y;
    z: 200;
    width: data.width;
    height: data.height;
}

export struct CloseAreaOverlayData {
    x: length,
    y: length,
    width: length,
    height: length,
}

export component CloseAreaOverlay inherits Rectangle {
    in property <CloseAreaOverlayData> data;
    background: blue;
    x: data.x;
    y: data.y;
    z: 199;
    width: data.width;
    height: data.height;
}

export component CloseAreaOverlays {
    in property <[CloseAreaOverlayData]> datas;
    for data[index] in datas: CloseAreaOverlay {
        data: data;
    }
}

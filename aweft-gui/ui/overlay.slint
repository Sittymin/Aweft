export struct SplitPreviewOverlayData {
    x1: length,
    y1: length,
    width1: length,
    height1: length,
    x2: length,
    y2: length,
    width2: length,
    height2: length,
}
export component SplitPreviewOverlay inherits Rectangle {
    in property <SplitPreviewOverlayData> data;

    Rectangle {
        x: data.x1;
        y: data.y1;
        width: data.width1;
        height: data.height1;
        border-color: rgba(1.0, 1.0, 1.0, 0.4);
        border-width: parent.border-width;
        // background: rgba(1.0, 1.0, 1.0, 0.10);
        background: red;
        z: 100;
    }

    Rectangle {
        x: data.x2;
        y: data.y2;
        width: data.width2;
        height: data.height2;
        border-color: blue;
        border-width: parent.border-width;
        background: rgba(1.0, 1.0, 1.0, 0.10);
        z: 100;
    }
}

export struct JoinHighlightOverlayData {
    x: length,
    y: length,
    width: length,
    height: length,
}

export component JoinHighlightOverlay inherits Rectangle {
    in property <JoinHighlightOverlayData> data;
    border-color: rgba(1.0, 1.0, 1.0, 0.4);
    background: rgba(1.0, 1.0, 1.0, 0.10);
    x: data.x;
    y: data.y;
    z: 2;
    width: data.width;
    height: data.height;
}

export struct AreaCloseOverlayData {
    x: length,
    y: length,
    width: length,
    height: length,
}

export component AreaCloseOverlay inherits Rectangle {
    in property <AreaCloseOverlayData> data;
    background: rgba(0.0, 0.0, 0.0, 0.7);
    x: data.x;
    y: data.y;
    z: 1;
    width: data.width;
    height: data.height;
}

export component AreaCloseOverlays {
    in property <[AreaCloseOverlayData]> datas;
    for data[index] in datas: AreaCloseOverlay {
        data: data;
    }
}

// TODO:
    // 多行同时编辑: 上下拖动可以跨越多行，同时编辑它们的属性（对于超多行可能实现困难并且有性能问题）
    // 区间拖动编辑: 通过拖动开始和结束时间之间的 "->" 图标，同时移动整个字幕的区间。

// 更加详细参数的侧边栏需要根据当前宽度和高度自行选择左右布局、上下布局、堆叠布局


export component TimecodeEditor inherits Rectangle {
    in property <image> chevron_left: @image-url("../assets/icons/chevron_left.svg");
    in property <image> chevron_right: @image-url("../assets/icons/chevron_right.svg");
    // 拖动阈值（像素）
    private property <length> drag-threshold: 5px;
    // 按钮宽度
    private property <length> button-width: 16px;

    // 各区域的拖动状态
    private property <bool> left-dragging: false;
    private property <bool> center-dragging: false;
    private property <bool> right-dragging: false;
    // 用于记录达到拖动阈值的起始位置
    private property <length> drag-start-x;
    // 用来共享当前累积偏移
    private property <length> accumulated-drag: 0px;
    // 记录拖动开始时的 Shift 键状态
    private property <bool> shift-pressed-on-drag-start: false;

    // 是否处于编辑模式
    in-out property <bool> is-editing: false;
    // 文本内容
    in-out property <string> text: "未输入";

    // 回调函数
    callback increment-timecode(is_batch: bool);
    callback decrement-timecode(is_batch: bool);
    callback drag-timecode-preview(delta-x: length, is_batch: bool);
    callback drag-timecode-commit(delta-x: length, is_batch: bool);
    callback drag-timecode-cancel(is_batch: bool);
    callback timecode-input(text: string);

    width: 100px;
    height: 20px;
    background: #545454;

    // 编辑模式：全宽输入框
    if (root.is-editing): Rectangle {
        width: 100%;
        height: 100%;
        background: #222222;
        clip: true;
        forward-focus: text-input;
        init => {
            text-input.focus();
            text-input.select-all();
        }
        text-input := TextInput {
            x: 4px;
            width: parent.width - 8px;
            height: 100%;
            text: root.text;
            color: #ffffff;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: center;
            changed has-focus => {
                if (!self.has-focus) {
                    root.is-editing = false;
                }
            }
            accepted => {
                root.is-editing = false;
                root.timecode-input(self.text)
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.is-editing = false;
                    return accept;
                }
                reject
            }
        }
    }

    // 非编辑模式：三区域布局
    if (!root.is-editing): Rectangle {
        // 底层完整的TouchArea
        base-touch := TouchArea {

            mouse-cursor: self.has-hover ? MouseCursor.ew-resize : MouseCursor.default;
            // TODO: 需要在 Rust 侧控制鼠标位置到开始拖动的位置
            // mouse-cursor: self.pressed ? MouseCursor.none : (self.has-hover ? MouseCursor.ew-resize : MouseCursor.default);

            pointer-event(event) => {
                if (event.button == PointerEventButton.right) {
                    if (root.center-dragging) {
                        root.drag-timecode-cancel(root.shift-pressed-on-drag-start);
                        debug("中间拖动已取消");
                        root.shift-pressed-on-drag-start = false;
                        root.right-dragging = false;
                        root.accumulated-drag = 0px;
                    }
                }
                // 在按下时记录 Shift 键状态（左右按钮拖动也有一致的逻辑）
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                    root.shift-pressed-on-drag-start = event.modifiers.shift;
                }
            }

            moved => {
                if (self.pressed) {
                    let delta-x = self.mouse-x - self.pressed-x;

                    // 检测是否达到阈值
                    if (!root.center-dragging && Math.abs(delta-x) > root.drag-threshold) {
                        root.center-dragging = true;
                        debug("中间开始拖动", delta-x);
                        root.drag-start-x = delta-x;
                    }
                    if (root.center-dragging) {
                        // 计算累积值：总距离 - 阈值偏移（保留方向）
                        root.accumulated-drag = delta-x - root.drag-start-x;
                        root.drag-timecode-preview(root.accumulated-drag, root.shift-pressed-on-drag-start);
                        debug("中间拖动中", root.accumulated-drag);
                    }
                }
            }
            clicked => {
                if (!root.center-dragging && !root.left-dragging && !root.right-dragging) {
                    root.is-editing = true;
                }
            }
            changed pressed => {
                // 松开鼠标
                if (!self.pressed) {
                    if (root.center-dragging) {
                        root.drag-timecode-commit(root.accumulated-drag, root.shift-pressed-on-drag-start);
                        debug("中间拖动提交", root.accumulated-drag);
                    }
                    root.shift-pressed-on-drag-start = false;
                    root.center-dragging = false;
                    root.accumulated-drag = 0px;
                }
            }

            // 显示文本
            Text {
                text: root.text;
                color: #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 11px;
            }

            // 左按钮作为子元素
            if (base-touch.has-hover): Rectangle {
                x: 0px;
                width: root.button-width;
                height: 100%;
                background: left-area.has-hover ? #656565 : (left-area.pressed ? #222222 : transparent);

                Image {
                    source: chevron_left;
                    width: 15px;
                    height: 15px;
                }

                // 左按钮按下时的半透明覆盖层
                if (left-area.pressed && !root.left-dragging): Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #00000040;  // 半透明黑色
                }
                left-area := TouchArea {
                    // 重要：设置不同的鼠标光标，这样就不会和父级冲突
                    mouse-cursor: root.left-dragging ? MouseCursor.ew-resize : (self.has-hover ? MouseCursor.pointer : MouseCursor.default);
                    // TODO: 需要在 Rust 侧控制鼠标位置到开始拖动的位置
                    // mouse-cursor: self.pressed ? MouseCursor.none : (self.has-hover ? MouseCursor.pointer : MouseCursor.default);

                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right) {
                            if (root.left-dragging) {
                                root.drag-timecode-cancel(root.shift-pressed-on-drag-start);
                                debug("左侧拖动已取消");
                                root.shift-pressed-on-drag-start = false;
                                root.left-dragging = false;
                                root.accumulated-drag = 0px;
                            }
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.shift-pressed-on-drag-start = event.modifiers.shift;
                        }
                    }

                    // 左按钮的完整交互逻辑（与中间部分差不多）
                    moved => {
                        if (self.pressed) {
                            let delta-x = self.mouse-x - self.pressed-x;
                            if (!root.left-dragging && Math.abs(delta-x) > root.drag-threshold) {
                                root.left-dragging = true;
                                debug("左侧开始拖动", delta-x);
                                root.drag-start-x = delta-x;
                            }
                            if (root.left-dragging) {
                                root.accumulated-drag = delta-x - root.drag-start-x;
                                root.drag-timecode-preview(root.accumulated-drag, root.shift-pressed-on-drag-start);
                                debug("左侧拖动中", root.accumulated-drag);
                            }
                        }
                    }
                    clicked => {
                        if (!root.left-dragging) {
                            root.decrement-timecode(root.shift-pressed-on-drag-start);
                        }
                    }
                    changed pressed => {
                        // 松开鼠标
                        if (!self.pressed) {
                            if (root.left-dragging) {
                                root.drag-timecode-commit(root.accumulated-drag, root.shift-pressed-on-drag-start);
                                debug("左侧拖动提交", root.accumulated-drag);
                            }
                            root.shift-pressed-on-drag-start = false;
                            root.left-dragging = false;
                            root.accumulated-drag = 0px;
                        }
                    }
                }
            }

            // 右按钮作为子元素
            if (base-touch.has-hover): Rectangle {
                x: parent.width - root.button-width;
                width: root.button-width;
                height: 100%;
                background: right-area.has-hover ? #656565 : (right-area.pressed ? #222222 : transparent);

                Image {
                    source: chevron_right;
                    width: 15px;
                    height: 15px;
                }

                if (right-area.pressed && !root.right-dragging): Rectangle {
                    width: 100%;
                    height: 100%;
                    background: #00000040;  // 半透明黑色
                }

                right-area := TouchArea {
                    mouse-cursor: self.has-hover ? MouseCursor.pointer : MouseCursor.default;
                    // TODO: 需要在 Rust 侧控制鼠标位置到开始拖动的位置
                    // mouse-cursor: self.pressed ? MouseCursor.none : (self.has-hover ? MouseCursor.pointer : MouseCursor.default);

                    // 右按钮的右键取消
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.right) {
                            if (root.right-dragging) {
                                root.drag-timecode-cancel(root.shift-pressed-on-drag-start);
                                debug("右侧拖动已取消");
                                root.shift-pressed-on-drag-start = false;
                                root.right-dragging = false;
                                root.accumulated-drag = 0px;
                            }
                        }
                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                            root.shift-pressed-on-drag-start = event.modifiers.shift;
                        }
                    }

                    // 右按钮的完整交互逻辑
                    moved => {
                        if (self.pressed) {
                            let delta-x = self.mouse-x - self.pressed-x;
                            if (!root.right-dragging && Math.abs(delta-x) > root.drag-threshold) {
                                root.right-dragging = true;
                                debug("右侧开始拖动", delta-x);
                                root.drag-start-x = delta-x;
                            }
                            if (root.right-dragging) {
                                root.accumulated-drag = delta-x - root.drag-start-x;
                                root.drag-timecode-preview(root.accumulated-drag, root.shift-pressed-on-drag-start);
                                debug("右侧拖动中", root.accumulated-drag);
                            }
                        }
                    }
                    clicked => {
                        if (!root.right-dragging) {
                            root.increment-timecode(root.shift-pressed-on-drag-start);
                        }
                    }
                    changed pressed => {
                        // 松开鼠标
                        if (!self.pressed) {
                            if (root.right-dragging) {
                                root.drag-timecode-commit(root.accumulated-drag, root.shift-pressed-on-drag-start);
                                debug("右侧拖动提交", root.accumulated-drag);
                            }
                            root.shift-pressed-on-drag-start = false;
                            root.right-dragging = false;
                            root.accumulated-drag = 0px;
                        }
                    }
                }
            }
            // 中间区域按下时或拖动时半透明覆盖层(在最后绘制，避免被其他部分覆盖)
            if (base-touch.pressed || root.left-dragging || root.right-dragging): Rectangle {
                width: 100%;
                height: 100%;
                background: #00000040;  // 半透明黑色 (25% 不透明度)
            }
        }
    }
}

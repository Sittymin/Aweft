import { Theme } from "../theme/index.slint";
export struct TableColumn {
    title: string,
    width: length,
    sort-order: SortOrder,
    min-width: length,
    horizontal-stretch: float,
}

component TableHeaderColumn inherits Rectangle {
    clip: false;
    in property <image> arrow_drop_down: @image-url("../assets/icons/arrow_drop_down.svg");
    in property <image> arrow_drop_up: @image-url("../assets/icons/arrow_drop_up.svg");
    in property <SortOrder> sort-order: SortOrder.unsorted;
    in property <bool> first;
    in property <bool> last;
    callback clicked;
    callback adjust-size(length);

    // click column(change sort-order)

    // first column
    // █████████████████████████████░░░
    if (root.first && !root.last): TouchArea {
        width: parent.width - (Theme.data.table-header.resize-handle-width / 2);
        clicked => {
            root.clicked();
        }
    }
    // middle column
    // ░░░██████████████████████████░░░
    if (!root.first && !root.last): TouchArea {
        x: Theme.data.table-header.resize-handle-width / 2;
        width: parent.width - Theme.data.table-header.resize-handle-width;
        clicked => {
            root.clicked();
        }
    }
    // last column
    // ░░░█████████████████████████████
    if (!root.first && root.last): TouchArea {
        x: Theme.data.table-header.resize-handle-width / 2;
        width: parent.width - (Theme.data.table-header.resize-handle-width / 2);
        clicked => {
            root.clicked();
        }
    }
    // single column
    // ████████████████████████████████
    if (root.first && root.last): TouchArea {
        width: parent.width;
        clicked => {
            root.clicked();
        }
    }

    layout := HorizontalLayout {
        padding-left: Theme.data.table-header.padding-horizontal;
        padding-right: Theme.data.table-header.padding-horizontal;
        spacing: Theme.data.table-header.spacing;

        @children

        Image {
            visible: root.sort-order != SortOrder.unsorted;
            source: root.sort-order == SortOrder.ascending ? arrow_drop_down : arrow_drop_up;
            width: Theme.data.table-header.sort-icon-size;
            height: Theme.data.table-header.sort-icon-size;
        }
    }

    // not first column and not single column
    if (!root.first && !(root.first && root.last)): Rectangle {

        // NOTE: since TouchArea cannot extend beyond its parent element, the parent element must enlarged.
        x: -(Theme.data.table-header.resize-handle-width / 2);
        width: Theme.data.table-header.resize-handle-width;
        height: 100%;

        // NOTE: it needs to be on the left; otherwise, the background color of the subsequent columns will overwrite the current background color.
        background: movable-touch-area.has-hover ? Theme.data.table-header.resize-hover-color : Theme.data.table-header.resize-color;
        animate background { duration: 150ms; }

        movable-touch-area := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed) {
                    adjust-size(self.mouse-x - self.pressed-x);
                }
            }
        }
    }
}

export component TableHeader inherits Rectangle {
    min-height: 10px;

    in property <[TableColumn]> columns;
    callback column-clicked(column-index: int);
    callback column-resized(column-index: int, new-width: length);
    callback height-resized(new-height: length);
    VerticalLayout {
        HorizontalLayout {
            for column[index] in columns: TableHeaderColumn {
                background: mod(index, 2) == 0 ? blue : green;
                first: index == 0;
                last: index == columns.length - 1;
                sort-order: column.sort-order;
                horizontal-stretch: column.horizontal-stretch;
                min-width: max(column.min-width, column.width);
                preferred-width: self.min-width;
            
                // column title
                Text {
                    text: column.title;
                    vertical-alignment: center;
                }

                clicked => {
                    root.column-clicked(index);
                }
                adjust-size(diff) => {
                    root.column-resized(/* modify the previous column */ index - 1, diff);
                }
            }
        }
    
        // bottom border
        Rectangle {
            width: 100%;
            height: Theme.data.table-header.bottom-divider-height;
            background: movable-touch-area.has-hover ? Theme.data.table-header.bottom-divider-hover-color : Theme.data.table-header.bottom-divider-color;
            animate background { duration: 150ms; }

            movable-touch-area := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: ns-resize;
                moved => {
                    if (self.pressed) {
                        height-resized(self.mouse-y - self.pressed-y);
                    }
                }
            }
        }
    }
}

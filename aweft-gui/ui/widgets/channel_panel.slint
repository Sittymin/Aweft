// 通道面板（曲线编辑器 / 摄影表共用左侧）：顶部搜索框 + 通道列表。
// 搜索框位于左上角、与顶部时间标尺同一行；列表在其下，行位置与画布行对齐。
// 摄影表传 pan-y（条带纵向滚动对齐）；曲线编辑器传 0（列表不随画布滚动）。
import { SlintFCurveChannel } from "../core/animation_types.slint";
import { Theme } from "../theme/index.slint";
import { ChannelList } from "../areas/graph_editor/channel_list.slint";
import { EditorSearchBar } from "../widgets/editor_search_bar.slint";

export component ChannelPanel inherits Rectangle {
    in property <[SlintFCurveChannel]> channels;
    // 列表纵向滚动偏移（px；摄影表与画布行共享）
    in property <float> pan-y: 0.0;
    in property <length> row-height;
    // 当前激活通道
    in property <int> current-channel: -1;
    // 搜索框高度（与顶部时间标尺同高）
    in property <length> search-height;
    // 汇总条带标题行高度（摄影表用：与画布汇总条带对齐；曲线编辑器传 0 不显示）
    in property <length> summary-height: 0px;

    callback search-changed(text: string);
    callback toggle-visible(index: int);
    callback toggle-modifier(index: int);
    callback toggle-active(index: int);
    callback toggle-editable(index: int);
    callback channel-pressed(index: int, mode: int);
    callback scrolled(delta: float);
    // 搜索框聚焦变化（编辑器据此设置全窗口编辑遮罩，挖孔定位）
    callback focus-changed(focused: bool);
    // 搜索遮罩激活镜像（由编辑器绑定 EditOverlayState.active）
    in property <bool> search-active-mirror: false;

    // 搜索框在本组件内的位置与大小（供编辑器遮罩据此挖孔；由 EditorSearchBar 上报）
    out property <length> search-box-x <=> search-bar.input-x;
    out property <length> search-box-y <=> search-bar.input-y;
    out property <length> search-box-width <=> search-bar.input-width;
    out property <length> search-box-height <=> search-bar.input-height;

    clip: true;

    // 共用搜索栏（左上角，与标尺同层背景）。必须显式 x/y：
    // Slint(1.17) 会把布局外无 x/y 的隐式尺寸元素居中到父内，否则搜索栏跑到面板中部
    // （见 editor_search_bar.slint 头注释）。
    search-bar := EditorSearchBar {
        x: 0px;
        y: 0px;
        width: 100%;
        search-height: root.search-height;
        search-active-mirror: root.search-active-mirror;
        placeholder-text: "搜索";
        text-changed(text) => {
            root.search-changed(text);
        }
        focus-changed(focused) => {
            root.focus-changed(focused);
        }
    }

    // 汇总条带标题行（摄影表用）：与画布汇总条带同高、同样式，标注这是汇总行。
    // 行位置固定（不随列表滚动），与画布汇总条带（固定首行）对齐。
    if root.summary-height > 0px: Rectangle {
        x: 0;
        y: root.search-height;
        width: 100%;
        height: root.summary-height;
        background: Theme.data.animation-editor.channel-row-selected;

        Text {
            x: 8px;
            width: 60px;
            height: 100%;
            text: "汇总";
            vertical-alignment: center;
            color: Theme.data.animation-editor.channel-text;
            font-size: 11px;
        }

        // 底部分隔线（与网格色一致）
        Rectangle {
            x: 0px;
            y: parent.height - 1px;
            width: 100%;
            height: 1px;
            background: Theme.data.animation-editor.grid-color;
        }
    }

    // 通道列表（搜索框与汇总标题之下；行位置 = i * row-height，与画布行对齐）
    ChannelList {
        x: 0;
        y: root.search-height + root.summary-height;
        width: 100%;
        height: root.height - root.search-height - root.summary-height;
        channels: root.channels;
        pan-y: root.pan-y;
        row-height: root.row-height;
        current-channel: root.current-channel;
        toggle-visible(i) => {
            root.toggle-visible(i);
        }
        toggle-modifier(i) => {
            root.toggle-modifier(i);
        }
        toggle-active(i) => {
            root.toggle-active(i);
        }
        toggle-editable(i) => {
            root.toggle-editable(i);
        }
        channel-pressed(i, mode) => {
            root.channel-pressed(i, mode);
        }
        scrolled(delta) => {
            root.scrolled(delta);
        }
    }
}

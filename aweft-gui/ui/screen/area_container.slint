import { SlintKey, SlintAreaType, ActionZoneCorner, GraphType } from "../core/types.slint";
import { ActionZone } from "action_zone.slint";
import { AreaHeader } from "../areas/area_header.slint";
import { LineEditor } from "../areas/line_editor/view.slint";
import { VideoPlayer } from "../areas/viewport/view.slint";
import { StyleGraphToolbar } from "../areas/style_graph/toolbar.slint";
import { AppGraphToolbar } from "../areas/app_graph/toolbar.slint";
import { NodeGraphEditor } from "../areas/node_graph/editor.slint";
import { GraphEditor } from "../areas/graph_editor/graph_editor.slint";
import { GraphEditorToolbar } from "../areas/graph_editor/toolbar.slint";
import { VideoState } from "../bridge/state.slint";
import { NodeGraphState, AnimationState } from "../bridge/state.slint";
import { Theme } from "../theme/index.slint";

// Area 容器组件：包含 Area 的边框、ActionZone 和内容
export component SlintScrArea inherits Rectangle {
    in property <SlintKey> area-key;
    in property <SlintAreaType> area-type;
    in property <length> container-x;
    in property <length> container-y;
    in property <length> container-width;
    in property <length> container-height;
    in property <length> actionzone-side-length;

    // 是否正在编辑链（节点图 Area 状态；切换 Area 类型时复位）
    private property <bool> chain-editing: false;

    x: container-x;
    y: container-y;
    width: container-width;
    height: container-height;
    border-width: Theme.data.area-container.border-width;
    border-color: Theme.data.area-container.border-color;
    VerticalLayout {
        spacing: Theme.data.area-container.content-spacing;
        // 每个 Area 恰好一个标题栏：未写各自 toolbar 的 Area 先用通用 AreaHeader
        if area-type == SlintAreaType.line-editor: AreaHeader {
            area-key: area-key;
            area-type: area-type;
        }
        if area-type == SlintAreaType.viewport: AreaHeader {
            area-key: area-key;
            area-type: area-type;
        }
        if area-type == SlintAreaType.style-graph-editor: StyleGraphToolbar {
            area-key: area-key;
            area-type: area-type;
            chain-editing <=> root.chain-editing;
        }
        if area-type == SlintAreaType.app-graph-editor: AppGraphToolbar {
            area-key: area-key;
            area-type: area-type;
            chain-editing <=> root.chain-editing;
        }
        if area-type == SlintAreaType.graph-editor: GraphEditorToolbar {
            area-key: area-key;
            area-type: area-type;
        }

        if area-type == SlintAreaType.line-editor: LineEditor { }
        if area-type == SlintAreaType.viewport: VideoPlayer {
            video-frame: VideoState.current-video-frame;
        }
        if area-type == SlintAreaType.style-graph-editor: style-editor := NodeGraphEditor {
            graph-type: GraphType.style-graph;
            chain-editing: root.chain-editing;
            nodes: NodeGraphState.style-nodes;
            links: NodeGraphState.style-links;
            menu-items: NodeGraphState.style-menu-items;
            lattice-tile: @image-url("../assets/textures/grid_square.svg");
            lattice-triangular: false;
            // 编辑器在窗口中的位置（输入框遮罩挖孔定位）
            window-x: root.container-x + self.x;
            window-y: root.container-y + self.y;
        }
        if area-type == SlintAreaType.app-graph-editor: app-editor := NodeGraphEditor {
            graph-type: GraphType.app-graph;
            chain-editing: root.chain-editing;
            nodes: NodeGraphState.app-nodes;
            links: NodeGraphState.app-links;
            menu-items: NodeGraphState.app-menu-items;
            lattice-tile: @image-url("../assets/textures/grid_triangle.svg");
            lattice-triangular: true;
            window-x: root.container-x + self.x;
            window-y: root.container-y + self.y;
        }
        if area-type == SlintAreaType.graph-editor: GraphEditor {
            channels: AnimationState.channels;
            graph-channels: AnimationState.graph-channels;
            segments: AnimationState.segments;
            graph-segments: AnimationState.graph-segments;
            handles: AnimationState.handles;
            graph-handles: AnimationState.graph-handles;
            current-time: AnimationState.current-time;
            action-start: AnimationState.action-start;
            action-end: AnimationState.action-end;
            current-channel: AnimationState.current-channel;
            selected-channels: AnimationState.selected-channels;
            preview-handles: AnimationState.preview-handles;
            extrapolations: AnimationState.extrapolations;
            selected-keyframes: AnimationState.selected-keyframes;
            selected-interpolation: AnimationState.selected-interpolation;
        }
    }

    // 切换 Area 类型后复位链编辑状态（不同 Area 的链体系不同）。
    // 切回样式图/应用图时若已有链数据则自动恢复编辑（无需重新点"新建"）。
    init => {
        root.restore-chain-editing();
    }
    changed area-type => {
        root.restore-chain-editing();
    }

    function restore-chain-editing() {
        if root.area-type == SlintAreaType.style-graph-editor {
            root.chain-editing = NodeGraphState.style-chain-items.length > 0;
        } else if root.area-type == SlintAreaType.app-graph-editor {
            root.chain-editing = NodeGraphState.app-chain-items.length > 0;
        } else {
            root.chain-editing = false;
        }
    }

    ActionZone {
        x: 0;
        y: 0;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.top-left;
        area-key: root.area-key;
        border-color: Theme.data.action-zone.top-left-border-color;
    }

    ActionZone {
        x: container-width - actionzone-side-length;
        y: 0;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.top-right;
        area-key: root.area-key;
        border-color: Theme.data.action-zone.top-right-border-color;
    }

    ActionZone {
        x: container-width - actionzone-side-length;
        y: container-height - actionzone-side-length;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.bottom-right;
        area-key: root.area-key;
        border-color: Theme.data.action-zone.bottom-right-border-color;
    }

    ActionZone {
        x: 0;
        y: container-height - actionzone-side-length;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.bottom-left;
        area-key: root.area-key;
        border-color: Theme.data.action-zone.bottom-left-border-color;
    }
}

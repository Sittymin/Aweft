import { Theme } from "../../theme/index.slint";
export struct JoinHighlightOverlayData {
    x: length,
    y: length,
    width: length,
    height: length,
}

export component JoinHighlightOverlay inherits Rectangle {
    in property <JoinHighlightOverlayData> data;
    border-color: Theme.data.join-highlight.border-color;
    background: Theme.data.join-highlight.background;
    x: data.x;
    y: data.y;
    z: 200;
    width: data.width;
    height: data.height;
}

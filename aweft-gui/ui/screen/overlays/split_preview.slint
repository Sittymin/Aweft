import { Theme } from "../../theme/index.slint";
export struct SplitPreviewOverlayData {
    x1: length,
    y1: length,
    width1: length,
    height1: length,
    x2: length,
    y2: length,
    width2: length,
    height2: length,
}

export component SplitPreviewOverlay inherits Rectangle {
    in property <SplitPreviewOverlayData> data;

    Rectangle {
        x: data.x1;
        y: data.y1;
        width: data.width1;
        height: data.height1;
        border-color: Theme.data.split-preview.border-color;
        border-width: Theme.data.split-preview.border-width;
        background: Theme.data.split-preview.background-primary;
        z: 200;
    }

    Rectangle {
        x: data.x2;
        y: data.y2;
        width: data.width2;
        height: data.height2;
        border-color: Theme.data.split-preview.border-color;
        border-width: Theme.data.split-preview.border-width;
        background: Theme.data.split-preview.background-secondary;
        z: 200;
    }
}

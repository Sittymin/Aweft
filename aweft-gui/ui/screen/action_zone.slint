import { ActionZoneCorner, SlintKey } from "../core/types.slint";
import { DragCallbacks } from "../bridge/callbacks.slint";
import { Theme } from "../theme/index.slint";

// ActionZone 组件：Area 四角的拖拽调整区
export component ActionZone inherits Rectangle {
    in property <ActionZoneCorner> position;
    in property <SlintKey> area-key;
    border-width: Theme.data.action-zone.border-width;
    property <bool> is-dragging;

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                // 开始拖拽
                root.is-dragging = true;
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.is-dragging) {
                // 松开时触发结束回调
                DragCallbacks.actionzone-drag-end(root.area-key, false);
                root.is-dragging = false;
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && root.is-dragging) {
                DragCallbacks.actionzone-drag-end(root.area-key, true);
                root.is-dragging = false;
            } else if (event.kind == PointerEventKind.move && root.is-dragging) {
                DragCallbacks.actionzone-drag(root.area-key, root.position, self.mouse-x, self.mouse-y);
            }
        }
    }
}

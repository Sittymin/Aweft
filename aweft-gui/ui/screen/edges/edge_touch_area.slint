import { ScrEdgeTouchAreaData } from "../../core/types.slint";
import { DragCallbacks } from "../../bridge/callbacks.slint";

// 边缘交互区域：处理边缘的拖拽操作
export component ScrEdgeTouchArea inherits TouchArea {
    in property <ScrEdgeTouchAreaData> touch-area-data;
    property <bool> is-dragging;
    x: touch-area-data.x;
    y: touch-area-data.y;
    width: touch-area-data.width;
    height: touch-area-data.height;
    changed has-hover => {
        if (self.has-hover) {
            // 指针进入区域时的回调
            // TODO: 添加一个回调用于将对应ScrEdgeDisplayData active设置
            debug("鼠标悬停进入");
        } else {
            // 指针离开区域时的回调
            debug("鼠标悬停离开");
        }
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            // 开始拖拽
            self.is-dragging = true;
        } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.is-dragging) {
            // 松开时触发结束回调
            DragCallbacks.edge-drag-end(false);
            self.is-dragging = false;
        } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && root.is-dragging) {
            DragCallbacks.edge-drag-end(true);
            self.is-dragging = false;
        } else if (event.kind == PointerEventKind.move && root.is-dragging) {
            DragCallbacks.edge-drag(root.touch-area-data.vert_keys, self.mouse-x, self.mouse-y);
        }
    }
}

import { ScrEdgeTouchAreaDisplayData } from "../../core/types.slint";

// 边缘显示组件：显示 Area 之间边缘的视觉效果
export component ScrEdgeDisplay inherits Rectangle {
    in property <ScrEdgeTouchAreaDisplayData> data;
    animate background { duration: 250ms; }
    // TODO: 还需要增加hover，并且由于需要仅有一个edge变色，所以需要传递到rust侧处理
    background: data.active ? rgba(255,0,0,1) : rgba(0,255,0,0.5);
    x: data.x;
    y: data.y;
    z: 100;
    width: data.width;
    height: data.height;
}

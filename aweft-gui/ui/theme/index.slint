import { Tokens } from "tokens.slint";
import { Mixins } from "mixins.slint";

export struct MainWindowTheme {
    border-width: length,
    area-min-size: length,
}

export struct SubtitleOverlayTheme {
    border-width: length,
    border-color: color,
}

export struct AreaContainerTheme {
    border-width: length,
    border-color: color,
    content-spacing: length,
}

export struct ActionZoneTheme {
    border-width: length,
    side-length: length,
    top-left-border-color: color,
    top-right-border-color: color,
    bottom-right-border-color: color,
    bottom-left-border-color: color,
}

export struct AreaHeaderTheme {
    height: length,
    background: color,
    padding: length,
    spacing: length,
    // 中区标题（Action 名称等）
    title-text: color,
    title-font-size: length,
}

export struct AreaTypeSwitcherPopupTheme {
    background: color,
    highlight-color: color,
    border-radius: length,
    border-width: length,
    border-color: color,
    padding: length,
    spacing: length,
    item-selected-background: color,
    item-padding-horizontal: length,
    item-spacing: length,
    item-min-height: length,
    item-icon-size: length,
    item-text-color: color,
    item-border-radius: length,
}

export struct AreaTypeSwitcherTheme {
    width: length,
    height: length,
    background: color,
    border-radius: length,
    border-width: length,
    border-color: color,
    layout-padding-horizontal: length,
    popup-icon-size: length,
    popup: AreaTypeSwitcherPopupTheme,
}

export struct TableHeaderTheme {
    min-height: length,
    padding-horizontal: length,
    spacing: length,
    sort-icon-size: length,
    resize-handle-width: length,
    resize-hover-color: color,
    resize-color: color,
    zebra-background-even: color,
    zebra-background-odd: color,
    bottom-divider-height: length,
    bottom-divider-hover-color: color,
    bottom-divider-color: color,
}

export struct LineEditorTheme {
    header-height: length,
    row-height: length,
}

export struct NodeEditorTheme {
    canvas-background: color,
    node-background: color,
    node-header-background: color,
    node-border: color,
    node-selected-outline: color,
    node-text: color,
    node-muted-text: color,
    node-width: length,
    node-header-height: length,
    node-socket-row-height: length,
    node-border-radius: length,
    node-title-font-size: length,
    node-socket-font-size: length,
    socket-size: length,
    socket-outline: color,
    socket-style-color: color,
    socket-float-color: color,
    socket-text-color: color,
    socket-int-color: color,
    socket-bool-color: color,
    socket-color-color: color,
    socket-vec2-color: color,
    socket-vec3-color: color,
    socket-clip-rect-color: color,
    socket-animation-color: color,
    link-color: color,
    link-width: length,
    link-stretch: length,
    lattice-color: color,
    lattice-base-spacing: length,
}

// 动画编辑器主题（曲线编辑器 + NLA 编辑器共用）
export struct AnimationEditorTheme {
    canvas-background: color,
    channel-list-background: color,
    channel-row-background: color,
    channel-row-selected: color,
    action-outside: color,
    channel-text: color,
    channel-muted-text: color,
    ruler-background: color,
    ruler-tick: color,
    ruler-text: color,
    lane-even: color,
    lane-odd: color,
    lane-active: color,
            strip-outline: color,
            strip-text: color,
            strip-gap: color,
            strip-inactive: color,
            strip-active: color,
            strip-moving: color,
            strip-group: color,
            action-keyframe: color,
            action-strip: color,
    action-strip-gap: color,
    playhead: color,
    playhead-handle-bg: color,
    preview-handle: color,
    marquee-fill: color,
    marquee-border: color,
    grid-color: color,
    grid-minor-color: color,
    sidebar-background: color,
    sidebar-border: color,
    sidebar-header-text: color,
    sidebar-muted-text: color,
    panel-header-background: color,
    panel-background: color,
    option-selected: color,
    option-hover: color,
    channel-row-height: length,
    track-row-height: length,
    ruler-height: length,
    channel-list-width: length,
    track-list-width: length,
    value-ruler-width: length,
    sidebar-tab-width: length,
    sidebar-tab-height: length,
    sidebar-content-width: length,
}

export struct EdgeDisplayTheme {
    width: length,
    active-color: color,
    inactive-color: color,
}

export struct SplitPreviewTheme {
    border-width: length,
    border-color: color,
    background-primary: color,
    background-secondary: color,
}

export struct JoinHighlightTheme {
    border-color: color,
    background: color,
}

export struct CloseAreaTheme {
    background: color,
}

export struct ThemeData {
    main-window: MainWindowTheme,
    subtitle-overlay: SubtitleOverlayTheme,
    area-container: AreaContainerTheme,
    action-zone: ActionZoneTheme,
    area-header: AreaHeaderTheme,
    area-type-switcher: AreaTypeSwitcherTheme,
    table-header: TableHeaderTheme,
    line-editor: LineEditorTheme,
    node-editor: NodeEditorTheme,
    animation-editor: AnimationEditorTheme,
    edge-display: EdgeDisplayTheme,
    split-preview: SplitPreviewTheme,
    join-highlight: JoinHighlightTheme,
    close-area: CloseAreaTheme,
}

export global Theme {
    in-out property <ThemeData> data: {
        main-window: {
            border-width: Tokens.data.layout.main-border-width,
            area-min-size: Tokens.data.layout.area-min-size,

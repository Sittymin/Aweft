export struct NeutralPalette {
    background: color,
    surface: color,
    header: color,
    border: color,
    border-strong: color,
    text: color,
    text-muted: color,
}

export struct WidgetPalette {
    combo-background: color,
    combo-border: color,
    popup-background: color,
    popup-border: color,
    popup-highlight: color,
    popup-item-selected: color,
    popup-item-text: color,
}

export struct AccentPalette {
    primary: color,
    warning: color,
    danger: color,
    info: color,
    success: color,
}

export struct AreaPalette {
    border-color: color,
}

export struct ActionZonePalette {
    top-left: color,
    top-right: color,
    bottom-right: color,
    bottom-left: color,
}

export struct OverlayPalette {
    border-width: length,
    subtitle-border: color,
    split-border: color,
    split-background-primary: color,
    split-background-secondary: color,
    join-border: color,
    join-background: color,
    close-background: color,
}

export struct EdgePalette {
    active: color,
    inactive: color,
}

export struct TablePalette {
    zebra-even: color,
    zebra-odd: color,
    resize-hover: color,
    resize: color,
    divider-hover: color,
    divider: color,
}

export struct NodeEditorPalette {
    canvas-background: color,
    node-background: color,
    node-header-background: color,
    node-border: color,
    // 选中节点时整圈描边高亮为偏白（纯白刺眼，用浅灰）
    node-selected-outline: color,
    node-text: color,
    node-muted-text: color,
    socket-outline: color,
    socket-style: color,
    socket-float: color,
    socket-text: color,
    socket-int: color,
    socket-bool: color,
    socket-color: color,
    socket-vec2: color,
    socket-vec3: color,
    socket-clip-rect: color,
    socket-animation: color,
    link: color,
    lattice: color,
}

// 动画编辑器（曲线编辑器 + NLA 编辑器）
export struct AnimationEditorPalette {
    canvas-background: color,
    // 左侧列表面板（比属性行稍亮，衬托出最暗的行）
    channel-list-background: color,
    // 属性行背景（最暗）
    channel-row-background: color,
    // 通道行选中背景（多选高亮）
    channel-row-selected: color,
    // Action 时长之外区域的遮罩色（半透明，置于网格之上）
    action-outside: color,
    channel-text: color,
    channel-muted-text: color,
    ruler-background: color,
    ruler-tick: color,
    ruler-text: color,
    lane-even: color,
    lane-odd: color,
    lane-active: color,
    strip-outline: color,
    strip-text: color,
    playhead: color,
    // 移动关键帧时预览的“钳制后”有效控制点颜色
    preview-handle: color,
    grid: color,
    // 次要网格线（Blender 主/次两级网格：主刻度用 grid，次刻度用 grid-minor）
    grid-minor: color,
    // 右侧边栏（Blender N 面板风格）
    sidebar-background: color,
    sidebar-border: color,
    sidebar-header-text: color,
    sidebar-muted-text: color,
    // 面板区块：头部略亮、主体略暗（Blender 面板样式）
    panel-header-background: color,
    panel-background: color,
    // 单选/展开项高亮
    option-selected: color,
    option-hover: color,
}

export struct SpacingTokens {
    xs: length,
    sm: length,
    md: length,
    lg: length,
}

export struct BorderTokens {
    thin: length,
    medium: length,
    thick: length,
    radius-xs: length,
    radius-sm: length,
    radius-md: length,
    node-editor-radius: length,
}

export struct ControlTokens {
    combo-width: length,
    combo-height: length,
    popup-icon-size: length,
    popup-item-icon-size: length,
    popup-item-min-height: length,
    line-header-height: length,
    line-row-height: length,
    table-header-min-height: length,
    table-header-padding-horizontal: length,
    table-header-spacing: length,
    sort-icon-size: length,
    resize-handle-width: length,
    table-bottom-divider-height: length,
    node-editor-node-width: length,
    node-editor-header-height: length,
    node-editor-socket-row-height: length,
    node-editor-socket-size: length,
    node-editor-link-width: length,
    node-editor-link-stretch: length,
    node-editor-title-font-size: length,
    node-editor-socket-font-size: length,
    node-editor-lattice-base: length,
    channel-row-height: length,
    track-row-height: length,
    ruler-height: length,
    channel-list-width: length,
    track-list-width: length,
    value-ruler-width: length,
    // 右侧边栏：分类 Tab 条宽度（竖排文字）/单个 Tab 高度/内容区宽度
    sidebar-tab-width: length,
    sidebar-tab-height: length,
    sidebar-content-width: length,
}

export struct LayoutTokens {
    main-border-width: length,
    area-spacing: length,
    area-header-height: length,
    area-header-spacing: length,
    actionzone-side-length: length,
    edge-width: length,
    area-min-size: length,
}

export struct ThemeTokens {
    neutral: NeutralPalette,
    widget: WidgetPalette,
    accent: AccentPalette,
    area: AreaPalette,
    action-zone: ActionZonePalette,
    overlay: OverlayPalette,
    edge: EdgePalette,
    table: TablePalette,
    node-editor: NodeEditorPalette,
    animation-editor: AnimationEditorPalette,
    spacing: SpacingTokens,
    border: BorderTokens,
    control: ControlTokens,
    layout: LayoutTokens,
}

export global Tokens {
    in-out property <ThemeTokens> data: 
    {
        neutral: {
            background: #181818,
            surface: #242424,
            header: #303030,
            border: #242424,
            border-strong: #3d3d3d,
            text: #e5e5e5,
            text-muted: #9fa4ad,
        },
        widget: {
            combo-background: #282828,
            combo-border: #3d3d3d,
            popup-background: #181818,
            popup-border: #242424,
            popup-highlight: rgba(255, 255, 255, 0.1),
            popup-item-selected: #4772b3,
            popup-item-text: #e5e5e5,
        },
        accent:  {
            primary: #4772b3,
            warning: #ff8000,
            danger: #ff0080,
            info: #0080ff,
            success: #00ffff,
        },
        area: {
            border-color: #00FFFF,
        },
        action-zone: {
            top-left: #FF0080,
            top-right: #0080FF,
            bottom-right: #FF8000,
            bottom-left: #FFFF00,
        },
        overlay: {
            border-width: 2px,
            subtitle-border: #778899,
            split-border: rgba(1.0, 1.0, 1.0, 0.4),
            split-background-primary: #ff0000,
            split-background-secondary: rgba(1.0, 1.0, 1.0, 0.10),
            join-border: rgba(1.0, 1.0, 1.0, 0.4),
            join-background: #ff0000,
            close-background: #0000ff,
        },
        edge: {
            active: rgba(255, 0, 0, 1),
            inactive: rgba(0, 255, 0, 0.5),
        },
        table: {
            zebra-even: #0000ff,
            zebra-odd: #00ff00,
            resize-hover: #ff0000,
            resize: rgba(1.0, 1.0, 1.0, 0.0),
            divider-hover: #ff0000,
            divider: rgba(1.0, 1.0, 1.0, 0.0),
        },
        node-editor: {
            canvas-background: #1d1d20,
            node-background: #34343a,
            node-header-background: #45454f,
            node-border: #4a4a52,
            // 选中节点时整圈描边高亮为偏白（纯白刺眼，用浅灰）
            node-selected-outline: #d0d0d6,
            node-text: #ececf0,
            node-muted-text: #a9adb8,
            socket-outline: #0e0e11,
            // style(样式链)
            socket-style: #63c763,
            // float(浮点)
            socket-float: #ffd166,
            // animation(动画)
            socket-animation: #ed9e5c,
            // text(文本)
            socket-text: #70b2ff,
            // int(整数)
            socket-int: #598c5c,
            // bool(布尔)
            socket-bool: #cca6d6,
            // color(颜色)
            socket-color: #f26d78,
            // vec2(向量2)
            socket-vec2: #4ecdc4,
            // vec3(向量3)
            socket-vec3: #45b7d1,
            // clip-rect(裁剪区域)
            socket-clip-rect: #b8a6d9,
            link: #63c763,
            lattice: #3a3a40,
        },
        animation-editor: {
            // 可用区（时长内）最亮，但不过曝
            canvas-background: #202026,
            // 列表面板稍亮，衬托最暗的属性行
            channel-list-background: #151519,
            // 属性行背景（最暗）
            channel-row-background: #0c0c0f,
            // 选中行背景（比普通行亮，突出多选）
            channel-row-selected: #232330,
            // Action 时长之外：比行亮、比时长内暗（半透明遮罩，盖在网格上）
            action-outside: rgba(0, 0, 0, 0.35),
            channel-text: #d6d6dc,
            channel-muted-text: #8a8a92,
            ruler-background: #202026,
            ruler-tick: #5c5c66,
            ruler-text: #a9adb8,
            lane-even: #26262b,
            lane-odd: #2b2b31,
            lane-active: #34343c,
            strip-outline: #101014,
            strip-text: #18181c,
            playhead: #e6a23c,
            // 预览钳制控制点：亮青色，与普通手柄区分
            preview-handle: #4ecdc4,
            grid: #2e2e34,
            // 次要网格线：比画布亮、比主网格线暗
            grid-minor: #27272d,
            // 右侧边栏（Blender N 面板风格）：略深于画布、浅于通道列表
            sidebar-background: #141418,
            sidebar-border: #2e2e34,
            sidebar-header-text: #d6d6dc,
            sidebar-muted-text: #8a8a92,
            // 面板区块：头部略亮、主体略暗
            panel-header-background: #232327,
            panel-background: #1c1c20,
            option-selected: #4772b3,
            option-hover: rgba(255, 255, 255, 0.08),
        },
        spacing: {
            xs: 4px,
            sm: 5px,
            md: 8px,
            lg: 10px,
        },
        border: {
            thin: 1px,
            medium: 2px,
            thick: 4px,
            radius-xs: 2px,
            radius-sm: 4px,
            radius-md: 6px,
            node-editor-radius: 6px,
        },
        control: {
            combo-width: 45px,
            combo-height: 20px,
            popup-icon-size: 15px,
            popup-item-icon-size: 20px,
            popup-item-min-height: 28px,
            line-header-height: 15px,
            line-row-height: 30px,
            table-header-min-height: 10px,
            table-header-padding-horizontal: 8px,
            table-header-spacing: 4px,
            sort-icon-size: 12px,
            resize-handle-width: 10px,
            table-bottom-divider-height: 5px,
            node-editor-node-width: 168px,
            node-editor-header-height: 24px,
            node-editor-socket-row-height: 22px,
            node-editor-socket-size: 14px,
            node-editor-link-width: 2px,
            node-editor-link-stretch: 56px,
            node-editor-title-font-size: 13px,
            node-editor-socket-font-size: 12px,
            node-editor-lattice-base: 28px,
            channel-row-height: 24px,
            track-row-height: 28px,
            ruler-height: 22px,
            channel-list-width: 170px,
            track-list-width: 170px,
            value-ruler-width: 46px,
            sidebar-tab-width: 24px,
            sidebar-tab-height: 64px,
            sidebar-content-width: 200px,
        },
        layout: {
            main-border-width: 2px,
            area-spacing: 5px,
            area-header-height: 35px,
            area-header-spacing: 10px,
            actionzone-side-length: 10px,
            edge-width: 10px,
            area-min-size: 50px,
        }
    };
}

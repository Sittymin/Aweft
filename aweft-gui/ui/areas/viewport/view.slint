// 视口播放器：多视频画布。
//  - 背景铺满整个 Area，使用比视频占位更亮的颜色；clip 限制在视口 Area 内
//  - 多个视频以世界坐标定位（每个会话自己的 position + 尺寸），主视频固定在
//    原点 (0,0)；新追加的视频相对当前选中（无选中则主视频）级联错开
//  - 主视频是唯一带矩形参考线的；选中视频描边（彩虹色）；点击命中重叠视频时
//    按选中顺序循环，拖拽可移动非主视频，右键弹菜单（设为主视频/更换视频）
//  - 横向/竖向标尺复用曲线编辑器的刻度文字（TickLabels，无背景、无刻度线、无网格），
//    直接浮在页面上：顶部横标尺 = 水平像素，左侧竖标尺 = 垂直像素
//  - 未加载视频时显示为黑色占位，加载后视频画面按 fill 铺在其内
import { CanvasNavigation } from "../../widgets/canvas_navigation.slint";
import { ContextMenu, MenuItem } from "../../widgets/context_menu.slint";
import { TickLabels } from "../graph_editor/ruler.slint";
import { Theme } from "../../theme/index.slint";
import { DismissOverlayState, SubtitleState, VideoState } from "../../bridge/state.slint";
import { VideoCallbacks } from "../../bridge/callbacks.slint";

export component VideoPlayer inherits Rectangle {
    background: #3a3a40;
    clip: true;

    // 画布导航状态（屏幕坐标 = 世界坐标 × 缩放 + 平移；两轴同比例缩放保持视频比例）
    private property <float> nav-pan-x: 0.0;
    private property <float> nav-pan-y: 0.0;
    private property <float> nav-zoom: 1.0;

    // 主视频世界尺寸（首帧到来时动态更新）：世界坐标基准面，其余视频按自身尺寸
    // 在其上定位；初始 0×0——无主视频时占位不可见，首帧到来后 re-fit。
    in-out property <float> video-world-w: VideoState.video-widths[VideoState.main-video] > 0
        ? VideoState.video-widths[VideoState.main-video]
        : 1920.0;
    in-out property <float> video-world-h: VideoState.video-heights[VideoState.main-video] > 0
        ? VideoState.video-heights[VideoState.main-video]
        : 1080.0;

    // 可见世界范围（X 水平像素 / Y 垂直像素，供标尺刻度计算）
    private property <float> view-x-lo: (0px - root.nav-pan-x * 1px) / (root.nav-zoom * 1px);
    private property <float> view-x-hi: (root.width / 1px - root.nav-pan-x) / root.nav-zoom;
    private property <float> view-y-lo: (0px - root.nav-pan-y * 1px) / (root.nav-zoom * 1px);
    private property <float> view-y-hi: (root.height / 1px - root.nav-pan-y) / root.nav-zoom;

    // 首次布局后适应视口一次（之后用户自由缩放/平移）；
    // 主视频尺寸到来/更换时重新适应（fitted 重置）。
    private property <bool> fitted: false;
    changed width => {
        root.try-fit();
    }
    changed height => {
        root.try-fit();
    }
    changed video-world-w => {
        root.fitted = false;
        root.try-fit();
    }
    changed video-world-h => {
        root.fitted = false;
        root.try-fit();
    }
    function try-fit() {
        if !root.fitted && root.width > 0px && root.height > 0px {
            root.fit-to-view();
            root.fitted = true;
        }
    }
    function fit-to-view() {
        let fit-z: float = min(
            root.width / (root.video-world-w * 1px),
            root.height / (root.video-world-h * 1px));
        if fit-z > 0.0 {
            root.nav-zoom = fit-z;
            root.nav-pan-x = (root.width / 1px - root.video-world-w * fit-z) / 2.0;
            root.nav-pan-y = (root.height / 1px - root.video-world-h * fit-z) / 2.0;
        }
    }

    // 拖拽移动非主视频的会话状态（marquee 机制判定点击 vs 拖动）
    private property <bool> moving-video: false;
    private property <int> moving-video-index: -1;
    private property <float> move-start-wx: 0.0;
    private property <float> move-start-wy: 0.0;
    private property <float> move-video-sx: 0.0;
    private property <float> move-video-sy: 0.0;

    // 右键菜单状态（目标视频下标 + 弹出位置）
    private property <bool> menu-open: false;
    private property <int> menu-video-index: -1;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;

    // 世界坐标 → 屏幕坐标辅助（供视频矩形/参考框/命中换算）
    function screen-x(wx: float) -> length {
        return root.nav-pan-x * 1px + wx * root.nav-zoom * 1px;
    }
    function screen-y(wy: float) -> length {
        return root.nav-pan-y * 1px + wy * root.nav-zoom * 1px;
    }
    function world-x(px: float) -> float {
        return (px - root.nav-pan-x) / root.nav-zoom;
    }
    function world-y(py: float) -> float {
        return (py - root.nav-pan-y) / root.nav-zoom;
    }

    // 主视频矩形（世界原点，尺寸 = 主视频世界尺寸）
    private property <length> main-rect-x: root.screen-x(0.0);
    private property <length> main-rect-y: root.screen-y(0.0);
    private property <length> main-rect-w: root.video-world-w * root.nav-zoom * 1px;
    private property <length> main-rect-h: root.video-world-h * root.nav-zoom * 1px;

    // 参考框（纯 UI）：以主视频为中心、按几何级数向外扩展的同心矩形。
    // 相邻框边长比恒定 → 间距等比递增，越靠近视频越密、越远越疏，便于定位；
    // 透明度随层数衰减，远处渐隐减少视觉干扰。数量/增长系数可调。
    // 仅在有视频时显示（无视频的空视口不画参考框）。
    private property <int> frame-count: 10;
    private property <float> frame-growth: 1.3; // 相邻框边长比（首框外扩 30%）
    private property <float> frame-opacity: 0.3; // 首框描边不透明度
    private property <float> frame-fade: 0.8; // 每向外一层的不透明度乘数

    for frame[i] in (VideoState.video-frames.length > 0 ? root.frame-count : 0): Rectangle {
        width: root.video-world-w * Math.pow(root.frame-growth, i + 1) * root.nav-zoom * 1px;
        height: root.video-world-h * Math.pow(root.frame-growth, i + 1) * root.nav-zoom * 1px;
        x: root.main-rect-x + (root.main-rect-w - self.width) / 2;
        y: root.main-rect-y + (root.main-rect-h - self.height) / 2;
        border-width: 1px;
        border-color: Theme.data.animation-editor.ruler-text;
        opacity: max(0.04, root.frame-opacity * Math.pow(root.frame-fade, i));
    }

    // 视频矩形（多个会话按下标依次绘制，最上层 = 最后绘制）。
    // 常驻描边 = 该视频彩虹色：选中时亮且加粗，非选中暗淡（不遮挡画面内容）。
    for v[i] in VideoState.video-frames.length: Rectangle {
        // 当前焦点视频稍后单独绘制到最上层，这里不绘制它
        visible: i != VideoState.selected-video;

        x: root.screen-x(VideoState.video-positions[i].x) - 3px;
        y: root.screen-y(VideoState.video-positions[i].y) - 3px;
        width: (VideoState.video-widths[i] > 0 ? VideoState.video-widths[i] : root.video-world-w)
            * root.nav-zoom * 1px + 6px;
        height: (VideoState.video-heights[i] > 0 ? VideoState.video-heights[i] : root.video-world-h)
            * root.nav-zoom * 1px + 6px;
        background: transparent;
        border-width: VideoState.time-bars[i].muted ? 2px : 0px;
        border-color: #d88bff.with-alpha(0.9);

        // 外框与画面容器都是常驻元素；静音切换只更新 border-width，不重建 UI。
        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            background: black;
            clip: true;
            border-width: VideoState.time-bars[i].selected ? 2px : 1px;
            border-color: VideoState.time-bars[i].color.with-alpha(
                VideoState.time-bars[i].selected ? 1.0 : 0.35);

            image := Image {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-tiling: none;
                vertical-tiling: none;
            // 矩形宽高由视频实际尺寸设置（含 PAR 换算），必须 fill 铺满；
            // contain 会以纹理存储比例兜底留黑边（变形片源）。
            image-fit: fill;
                source: VideoState.video-frames[i];
            }
        }
    }
    // 当前焦点视频单独绘制在所有普通视频之后，避免被其它视频遮挡。
    if VideoState.selected-video >= 0
        && VideoState.selected-video < VideoState.video-frames.length: Rectangle {
        property <int> index: VideoState.selected-video;

        x: root.screen-x(VideoState.video-positions[index].x) - 3px;
        y: root.screen-y(VideoState.video-positions[index].y) - 3px;
        width: (VideoState.video-widths[index] > 0
            ? VideoState.video-widths[index]
            : root.video-world-w) * root.nav-zoom * 1px + 6px;
        height: (VideoState.video-heights[index] > 0
            ? VideoState.video-heights[index]
            : root.video-world-h) * root.nav-zoom * 1px + 6px;
        background: transparent;
        border-width: VideoState.time-bars[index].muted ? 2px : 0px;
        border-color: #d88bff.with-alpha(0.9);

        Rectangle {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            background: black;
            clip: true;
            border-width: VideoState.time-bars[index].selected ? 2px : 1px;
            border-color: VideoState.time-bars[index].color.with-alpha(
            VideoState.time-bars[index].selected ? 1.0 : 0.35);

            Image {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-tiling: none;
                vertical-tiling: none;
                image-fit: fill;
                source: VideoState.video-frames[index];
            }
        }
    }

    // 字幕覆盖层：贴在主视频矩形上的整帧图。帧的排版比例 = 主视频显示像素比例，
    // 但纹理按这个矩形在屏幕上的**物理像素数**光栅化（1:1，放大字幕时不发虚），
    // 倍率由 Rust 决定，见 `render::subtitle::pipeline::raster_size`。
    // 声明在所有视频矩形之后、标尺之前：字幕压在画面上，但不遮标尺。
    // 缩放/平移与主视频共用同一组 screen-x/screen-y。
    Rectangle {
        x: root.main-rect-x;
        y: root.main-rect-y;
        width: root.main-rect-w;
        height: root.main-rect-h;
        clip: true;
        // 逻辑尺寸报给 Rust 换算光栅尺寸（.slint 读不到 scale factor）。
        // 只有缩放手势与改窗口尺寸会触发，档位之外的抖动在 Rust 侧被吸收。
        changed width => {
            SubtitleState.report-overlay-size(root.main-rect-w, root.main-rect-h);
        }
        changed height => {
            SubtitleState.report-overlay-size(root.main-rect-w, root.main-rect-h);
        }

        Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            image-fit: fill;
            source: SubtitleState.current-subtitle-frame;
        }
    }

    // 顶部横向标尺：无背景、无刻度线，仅主刻度数字（水平像素）
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 16px;
        clip: true;
        TickLabels {
            width: 100%;
            height: 100%;
            vertical: true;
            view-lo: root.view-x-lo;
            view-hi: root.view-x-hi;
            zoom: root.nav-zoom;
            pan: root.nav-pan-x;
            label-color: Theme.data.animation-editor.ruler-text;
        }
    }

    // 左侧竖向标尺：无背景、无刻度线，仅主刻度数字（垂直像素）
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        clip: true;
        TickLabels {
            width: 100%;
            height: 100%;
            vertical: false;
            view-lo: root.view-y-lo;
            view-hi: root.view-y-hi;
            zoom: root.nav-zoom;
            pan: root.nav-pan-y;
            label-color: Theme.data.animation-editor.ruler-text;
        }
    }

    // 画布导航（置于最上层；视频矩形与标尺均无 TouchArea，事件全部由它接管）。
    // 左键点击 → 命中选中视频（重叠循环）；左键拖拽起点命中非主视频 → 移动它；
    // 右键命中视频 → 弹上下文菜单。
    nav := CanvasNavigation {
        width: 100%;
        height: 100%;
        pan-x <=> root.nav-pan-x;
        pan-y <=> root.nav-pan-y;
        zoom-x <=> root.nav-zoom;
        zoom-y <=> root.nav-zoom;
        max-zoom: 16.0;
        zoom-step: 1.2;
        marquee-enabled: true;
        marquee-dragged(x1, y1, x2, y2) => {
            // 首次拖动：判定起点是否命中非主视频 → 进入移动会话
            if !root.moving-video {
                let wx: float = root.world-x(x1);
                let wy: float = root.world-y(y1);
                let idx: int = VideoCallbacks.video-hit-top(wx, wy);
                if idx >= 0 && idx != VideoState.main-video {
                    root.moving-video = true;
                    root.moving-video-index = idx;
                    root.move-start-wx = wx;
                    root.move-start-wy = wy;
                    root.move-video-sx = VideoState.video-positions[idx].x;
                    root.move-video-sy = VideoState.video-positions[idx].y;
                }
            }
            if root.moving-video {
                let wx: float = root.world-x(x2);
                let wy: float = root.world-y(y2);
                VideoCallbacks.video-moved(
                    root.moving-video-index,
                    root.move-video-sx + (wx - root.move-start-wx),
                    root.move-video-sy + (wy - root.move-start-wy));
            }
        }
        marquee-done(x1, y1, x2, y2, modifier) => {
            root.moving-video = false;
        }
        background-pressed(modifier) => {
            // 点击（未拖成移动）：命中选中视频（重叠时按选中顺序循环）
            let wx: float = root.world-x(nav.mouse-x / 1px);
            let wy: float = root.world-y(nav.mouse-y / 1px);
            VideoCallbacks.select-video(VideoCallbacks.video-picked(wx, wy), modifier);
        }
        context-pressed(x, y) => {
            // 右键命中视频 → 弹上下文菜单（设为主视频/更换视频）
            let wx: float = root.world-x(x);
            let wy: float = root.world-y(y);
            let idx: int = VideoCallbacks.video-hit-top(wx, wy);
            if idx >= 0 {
                root.menu-video-index = idx;
                root.menu-x = x * 1px;
                root.menu-y = y * 1px;
                root.menu-open = true;
            }
        }
    }

    // 视频右键菜单：非主视频可设为主视频；所有视频可切换静音/更换视频。
    // 常驻实例（visible 由 open 控制）：菜单收起时才触发 overlay-hidden 释放遮罩。
    // 点菜单外任意处收起由 MainWindow 顶层 DismissOverlay 负责。
    ContextMenu {
        open <=> root.menu-open;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        container-width: root.width;
        container-height: root.height;
        clamp-position: true;
        overlay-active: DismissOverlayState.active;
        overlay-shown(rect) => {
            DismissOverlayState.show(rect);
        }
        overlay-hidden() => {
            DismissOverlayState.hide();
        }
        if root.menu-video-index != VideoState.main-video: MenuItem {
            text: "设为主视频";
            menu-open <=> root.menu-open;
            activated => {
                VideoCallbacks.set-main-video(root.menu-video-index);
            }
        }
        MenuItem {
            text: VideoState.time-bars[root.menu-video-index].muted ? "取消静音" : "静音";
            menu-open <=> root.menu-open;
            activated => {
                VideoCallbacks.toggle-mute-video(root.menu-video-index);
            }
        }

        MenuItem {
            text: "更换视频";
            menu-open <=> root.menu-open;
            activated => {
                VideoCallbacks.replace-video(root.menu-video-index);
            }
        }
    }
}

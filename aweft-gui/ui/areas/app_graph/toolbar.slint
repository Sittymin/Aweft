// 应用图标题栏：链列表/当前链索引来自 Rust 全局，向通用 AreaHeader 传入，并接入加载回调。
import { SlintKey, SlintAreaType, GraphType } from "../../core/types.slint";
import { AreaHeader, AreaHeaderCenterMode } from "../area_header.slint";
import { NodeGraphCallbacks } from "../../bridge/callbacks.slint";
import { NodeGraphState } from "../../bridge/state.slint";

export component AppGraphToolbar inherits Rectangle {
    in property <SlintKey> area-key;
    in property <SlintAreaType> area-type;
    in-out property <bool> chain-editing: false;

    // 进入编辑：加载当前选中的链（切 Area 回来自动恢复，无需重新点"新建"）
    changed chain-editing => {
        if root.chain-editing {
            NodeGraphCallbacks.load-chain(GraphType.app-graph, NodeGraphState.app-current-chain);
        }
    }

    AreaHeader {
        width: 100%;
        height: 100%;
        area-key: root.area-key;
        area-type: root.area-type;
        center-mode: AreaHeaderCenterMode.chain;
        chain-items: NodeGraphState.app-chain-items;
        current-chain-index: NodeGraphState.app-current-chain;
        chain-editing <=> root.chain-editing;
        chain-selected(index) => {
            NodeGraphState.app-current-chain = index;
            NodeGraphCallbacks.load-chain(GraphType.app-graph, index);
        }
        new-chain => {
            NodeGraphState.app-current-chain = NodeGraphCallbacks.new-chain(GraphType.app-graph);
        }
        // 右侧操作按钮（占位，作用由 Rust 侧数据驱动）
        right-actions: [
            { icon: @image-url("../../assets/icons/keep.svg") },
            { icon: @image-url("../../assets/icons/grid_4x4.svg") },
            { icon: @image-url("../../assets/icons/grid_on.svg") },
        ];
    }
}

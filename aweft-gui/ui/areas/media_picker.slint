// 媒体选择弹层（仅 Android 用）：MediaStore 视频列表，点行即选。
// 行文案由 Rust 拼好（名 · 时长 · 大小），这里只管显示与点选，
// 配色用字面量，不碰 Theme（避免主题字段耦合）。

import { ListView } from "std-widgets.slint";

export component MediaPicker inherits Rectangle {
    callback pick(index: int);
    callback cancel();

    in property <[string]> items;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;

    // 整屏遮罩：点孔外即取消
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.cancel();
        }
    }

    // 居中卡片
    card := Rectangle {
        width: min(560px, parent.width - 48px);
        height: min(480px, parent.height - 96px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #1e1e1ef2;
        border-radius: 12px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: "选择视频";
                font-size: 18px;
                color: #ffffff;
            }

            ListView {
                vertical-stretch: 1;
                for item[i] in items: row := Rectangle {
                    height: 44px;
                    background: row-touch.has-hover ? #ffffff22 : transparent;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            vertical-alignment: center;
                            vertical-stretch: 1;
                            text: item;
                            font-size: 14px;
                            color: #dddddd;
                            overflow: elide;
                        }
                    }
                    row-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.pick(i);
                        }
                    }
                }
            }

            TouchArea {
                height: 40px;
                clicked => {
                    root.cancel();
                }
                Text {
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: "取消";
                    font-size: 15px;
                    color: #888888;
                }
            }
        }
    }
}

import { Theme } from "../theme/index.slint";
import { CanvasNavigation } from "../widgets/canvas_navigation.slint";
import { ContextMenu, MenuItem } from "../widgets/context_menu.slint";
import { TimeRuler, VerticalGrid } from "./graph_editor/ruler.slint";
import { SlintAudioTrack, SlintKey, SlintWaveformBucket } from "../core/types.slint";
import { AnimationState, AudioState, VideoState } from "../bridge/state.slint";
import { VideoCallbacks, AudioCallbacks } from "../bridge/callbacks.slint";
import { AudioTrackPanel } from "./audio_track_panel.slint";
import { AudioTrackSidebar } from "./audio_track_sidebar.slint";

component WaveformBar inherits Rectangle {
    in property <float> bucket-min: 0.0;
    in property <float> bucket-max: 0.0;
    in property <float> bucket-rms: 0.0;

    background: transparent;

    // 单像素竖线（Audacity 式）：min→max 外线 + 显示 rms 的内层线条（加亮），宽度跟随槽位。
    // 零桶（全 0）退化为中心 1px 点；值域 [-1, 1] 映射到柱高。
    Rectangle {
        width: parent.width;
        height: Math.max(1px, parent.height * (root.bucket-max - root.bucket-min) * 0.47);
        y: parent.height * (1.0 - root.bucket-max) * 0.5;
        background: Theme.data.animation-editor.strip-active;
    }
    Rectangle {
        width: parent.width;
        height: Math.max(1px, parent.height * (root.bucket-rms - (-root.bucket-rms)) * 0.47);
        y: parent.height * (1.0 - root.bucket-rms) * 0.5;
        background: Theme.data.animation-editor.strip-active.brighter(0.4);
    }
}

export component AudioWaveformArea inherits Rectangle {
    private property <float> selection-start: 2.8;
    private property <float> selection-end: 7.55;
    private property <length> ruler-height: Theme.data.animation-editor.ruler-height;
    private property <length> track-list-width: Theme.data.animation-editor.channel-list-width;
    private property <length> sidebar-tab-width: Theme.data.animation-editor.sidebar-tab-width;
    private property <length> sidebar-content-width: Theme.data.animation-editor.sidebar-content-width;
    private property <length> sidebar-width: root.sidebar-open
        ? root.sidebar-tab-width + root.sidebar-content-width
        : root.sidebar-tab-width;
    private property <bool> sidebar-open: false;
    in property <[SlintAudioTrack]> tracks: [];
    in property <int> track-index: 0;
    in property <SlintKey> area-key;
    callback track-selected(index: int);

    // The navigation transform is shared by waveform buckets, ruler, grid, selection and playhead.
    private property <float> nav-pan-x: 0.0;
    private property <float> nav-zoom: 30.0;
    private property <float> view-time-lo: (0px - root.nav-pan-x * 1px) / (root.nav-zoom * 1px);
    private property <float> view-time-hi: (canvas.width - root.nav-pan-x * 1px) / (root.nav-zoom * 1px);
    private property <bool> has-waveform: root.track-index >= 0
        && root.track-index < root.tracks.length;
    // Audacity 式密度：每像素约一列。target 是“每像素秒数”，列宽取 ≥ 该值的
    // 最细 1/2/5×10^k 档（1ms、2ms、5ms……）。横向标尺（TimeRuler/VerticalGrid）
    // 只管刻度，不管波形密度。列数据由 Rust 现算（见 compute-columns），这里只定窗口。
    pure function waveform-bucket-duration() -> float {
        let target = 1.0 / root.nav-zoom;
        if target <= 0.001 { return 0.001; }
        if target <= 0.002 { return 0.002; }
        if target <= 0.005 { return 0.005; }
        if target <= 0.010 { return 0.010; }
        if target <= 0.020 { return 0.020; }
        if target <= 0.050 { return 0.050; }
        if target <= 0.100 { return 0.100; }
        if target <= 0.200 { return 0.200; }
        if target <= 0.500 { return 0.500; }
        if target <= 1.000 { return 1.000; }
        if target <= 2.000 { return 2.000; }
        if target <= 5.000 { return 5.000; }
        if target <= 10.000 { return 10.000; }
        if target <= 20.000 { return 20.000; }
        if target <= 50.000 { return 50.000; }
        if target <= 100.000 { return 100.000; }
        if target <= 200.000 { return 200.000; }
        if target <= 500.000 { return 500.000; }
        if target <= 1000.000 { return 1000.000; }
        if target <= 2000.000 { return 2000.000; }
        if target <= 5000.000 { return 5000.000; }
        if target <= 10000.000 { return 10000.000; }
        if target <= 20000.000 { return 20000.000; }
        if target <= 50000.000 { return 50000.000; }
        return 100000.000;
    }

    pure function waveform-first-bucket() -> int {
        return floor(root.view-time-lo / root.waveform-bucket-duration()) - 1;
    }

    // 可视时间区间对应的最后一个桶（包含与右边界相交的桶）。
    // 这是每个 Area 自己的派生状态；不同 Area 的 pan/zoom 不会互相影响。
    pure function waveform-last-bucket() -> int {
        return ceil(root.view-time-hi / root.waveform-bucket-duration());
    }

    // 槽位数量按当前 Area 的可视时间范围计算，而不是按音频总长度计算。
    // 这样缩放后只保留视区内的柱；高倍缩放时也不会因为固定槽位数而截断视区。
    pure function waveform-slot-count() -> int {
        return max(1, root.waveform-last-bucket() - root.waveform-first-bucket() + 2);
    }

    // 持久列模型：窗口（首桶、列数）与上列函数同源，列下标恒等于槽位序号；
    // 绑定重求值恒返回同一模型（标识不变，槽位不重建），行值与数量由 Rust 增量同步。
    // 新批次到达由 pump 直接写列模型触发重绘，不经过本绑定。
    property <[SlintWaveformBucket]> wave-columns: AudioCallbacks.waveform-view(
        root.area-key,
        root.video-index,
        root.track-index,
        root.waveform-bucket-duration(),
        root.waveform-first-bucket(),
        root.waveform-slot-count());

    pure function waveform-bucket-min(slot: int) -> float {
        if slot < 0 || slot >= root.wave-columns.length { return 0.0; }
        return root.wave-columns[slot].min;
    }

    pure function waveform-bucket-max(slot: int) -> float {
        if slot < 0 || slot >= root.wave-columns.length { return 0.0; }
        return root.wave-columns[slot].max;
    }

    pure function waveform-bucket-rms(slot: int) -> float {
        if slot < 0 || slot >= root.wave-columns.length { return 0.0; }
        return root.wave-columns[slot].rms;
    }

    in property <int> video-index: 0;
    private property <int> focus-video-index: VideoState.selected-video >= 0
        ? VideoState.selected-video
        : VideoState.main-video;
    private property <float> actual-time: root.video-index >= 0
        && root.video-index < VideoState.time-bars.length
        ? VideoState.time-bars[root.video-index].time : 0.0;
    private property <float> duration: root.video-index >= 0
        && root.video-index < VideoState.time-bars.length
        ? VideoState.time-bars[root.video-index].duration : 0.0;
    private property <color> actual-time-color: root.video-index >= 0
        && root.video-index < VideoState.time-bars.length
        ? VideoState.time-bars[root.video-index].color : transparent;
    // 非焦点音轨没有全局动画时间可保存范围外请求，因此只在越界时由本 Area
    // 暂存逻辑时间；有效范围内仍直接跟随视频会话的实际播放位置。
    private property <bool> has-outside-time: false;
    private property <float> outside-time: 0.0;
    private property <float> current-time: root.video-index == root.focus-video-index
        ? AnimationState.current-time
        : root.has-outside-time ? root.outside-time : root.actual-time;

    private property <int> playback-track-index: root.video-index >= 0
        && root.video-index < AudioState.playback-tracks.length
        ? AudioState.playback-tracks[root.video-index] : -1;
    private property <bool> menu-open: false;
    private property <int> menu-track-index: -1;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;

    background: Theme.data.animation-editor.canvas-background;

    AudioTrackPanel {
        x: 0px;
        y: 0px;
        width: root.track-list-width;
        height: root.height;
        tracks: root.tracks;
        current-track: root.track-index;
        playback-track: root.playback-track-index;
        header-height: root.ruler-height;
        track-pressed(index) => {
            root.track-selected(index);
        }
        track-context-menu(index, mx, my) => {
            root.track-selected(index);
            root.menu-track-index = index;
            root.menu-x = mx;
            root.menu-y = my;
            root.menu-open = true;
        }
    }

    TimeRuler {
        x: root.track-list-width;
        y: 0px;
        width: parent.width - root.track-list-width - root.sidebar-width;
        height: root.ruler-height;
        view-lo: root.view-time-lo;
        view-hi: root.view-time-hi;
        zoom-x: root.nav-zoom;
        pan-x: root.nav-pan-x;
        current-time: root.current-time;
        show-reference-time: root.video-index >= 0;
        reference-time: root.actual-time;
        reference-time-color: root.actual-time-color;
        time-picked(time) => {
            root.outside-time = time;
            root.has-outside-time = root.video-index != root.focus-video-index
                && root.duration > 0.0
                && (time < 0.0 || time >= root.duration);
            VideoCallbacks.seek-video(root.video-index, time);
        }
    }

    canvas := Rectangle {
        x: root.track-list-width;
        y: root.ruler-height;
        width: parent.width - root.track-list-width - root.sidebar-width;
        height: parent.height - root.ruler-height;
        clip: true;
        background: Theme.data.animation-editor.canvas-background;

        VerticalGrid {
            width: 100%;
            height: 100%;
            view-lo: root.view-time-lo;
            view-hi: root.view-time-hi;
            zoom-x: root.nav-zoom;
            pan-x: root.nav-pan-x;
            line-color: Theme.data.animation-editor.grid-color;
            minor-line-color: Theme.data.animation-editor.grid-minor-color;
        }

        Rectangle {
            x: root.selection-start * root.nav-zoom * 1px + root.nav-pan-x * 1px;
            width: (root.selection-end - root.selection-start) * root.nav-zoom * 1px;
            height: parent.height;
            background: Theme.data.animation-editor.marquee-fill.with-alpha(42%);
        }

        Rectangle {
            y: parent.height * 0.5;
            width: parent.width;
            height: 1px;
            background: Theme.data.animation-editor.grid-color;
        }

        // 桶屏宽驱动的持久槽位池。缩放选择预聚合波形层，平移只改变首桶下标；
        // WaveformBar 本身不随原始波形长度或视图导航反复创建/销毁。
        if root.has-waveform: Rectangle {
            width: 100%;
            height: 100%;
            // 播放时播放头每帧都走，波形本体只在新批次/缩放时变；缓存层避免静态帧重复光栅化。
            cache-rendering-hint: true;
            for slot in root.waveform-slot-count(): WaveformBar {
                private property <int> bucket-row: root.waveform-first-bucket() + slot;
                private property <float> bucket-start: self.bucket-row * root.waveform-bucket-duration();
                private property <float> bucket-end: (self.bucket-row + 1) * root.waveform-bucket-duration();
                // 只保留与当前 Area 可视时间区间相交的柱。列数组边界判断仍然保留，
                // 这样异步波形尚未解码到该区间时不会读取越界数据（越界列为零桶）。
                visible: slot < root.wave-columns.length
                    && self.bucket-row <= root.waveform-last-bucket()
                    && self.bucket-end >= root.view-time-lo;
                x: self.bucket-row * root.waveform-bucket-duration() * root.nav-zoom * 1px
                    + root.nav-pan-x * 1px;
                y: 12px;
                // 槽位宽度 = 桶屏宽：层级选择已保证桶屏宽 ≥ 1px（每像素约一列），
                // 正常缩放下即 1px 线；极限放大时线加宽铺满桶区间成 band。
                // 相邻槽位恰好平铺（x 按桶起始定位），无缝隙无重叠。
                width: max(1px, root.waveform-bucket-duration() * root.nav-zoom * 1px);
                height: parent.height - 24px;
                bucket-min: root.waveform-bucket-min(slot);
                bucket-max: root.waveform-bucket-max(slot);
                bucket-rms: root.waveform-bucket-rms(slot);
            }
        }

        CanvasNavigation {
            pan-x <=> root.nav-pan-x;
            zoom-x <=> root.nav-zoom;
            lock-y-zoom: true;
            max-zoom: 12000.0;
            zoom-step: 1.5;
        }

        // 视频画面实际时间；范围外定位时停在最近的有效帧。
        Rectangle {
            x: (root.actual-time * root.nav-zoom * 1px + root.nav-pan-x * 1px) - self.width / 2;
            width: 2px;
            height: parent.height;
            background: root.actual-time-color;
        }

        // 逻辑播放头允许位于媒体范围之外，供字幕等动画锚点使用。
        Rectangle {
            x: root.current-time * root.nav-zoom * 1px + root.nav-pan-x * 1px;
            width: 1px;
            height: parent.height;
            background: Theme.data.animation-editor.playhead;
        }
    }

    AudioTrackSidebar {
        x: root.width - root.sidebar-width;
        y: 0px;
        width: root.sidebar-width;
        height: root.height;
        open <=> root.sidebar-open;
        tracks: root.tracks;
        current-track: root.track-index;
    }

    // 右键菜单打开时的背景点击层：点菜单外任意处关闭
    if root.menu-open: TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.menu-open = false;
            }
        }
    }

    // 音轨右键上下文菜单
    if root.menu-open: ContextMenu {
        open <=> root.menu-open;
        menu-x: root.menu-x;
        menu-y: root.menu-y;
        container-width: root.width;
        container-height: root.height;
        clamp-position: true;
        MenuItem {
            text: root.menu-track-index == root.playback-track-index ? "已是当前播放音轨" : "设置为当前播放音轨";
            enabled: root.menu-track-index != root.playback-track-index;
            menu-open <=> root.menu-open;
            activated => {
                AudioCallbacks.select-audio-track(root.video-index, root.menu-track-index);
            }
        }
    }

    changed video-index => { root.has-outside-time = false; }
    changed focus-video-index => { root.has-outside-time = false; }
}

// 摄影表（Dope Sheet）基础元素：单行时间轴上的关键帧菱形。
// 与曲线编辑器关键帧类似，但只按时间定位（行高由泳道决定），拖拽只调整时间。
import { Theme } from "../../theme/index.slint";

export component DopeKeyframe inherits Rectangle {
    in property <float> time: 0.0;
    in property <color> marker-color;
    in property <bool> selected: false;
    // X 轴缩放（时间）
    in property <float> view-zoom: 1.0;
    in property <float> pan-x: 0.0;
    in property <length> row-height: 24px;

    callback pressed(additive: bool);
    callback dragged(delta-time: float);
    callback released();

    private property <length> marker-size: 9px;
    // 命中区域比菱形视觉略大
    private property <length> hit-size: marker-size + 8px;
    private property <bool> dragging: false;
    private property <float> press-mouse-x: 0.0;

    // 菱形中心垂直居中于所在行
    x: root.time * root.view-zoom * 1px + root.pan-x * 1px - hit-size / 2;
    y: (root.row-height - hit-size) / 2;
    width: hit-size;
    height: hit-size;
    background: transparent;

    // 菱形视觉（旋转 45° 的方块）
    Rectangle {
        width: root.marker-size;
        height: root.marker-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        transform-origin: { x: root.marker-size / 2, y: root.marker-size / 2 };
        transform-rotation: 45deg;
        background: root.selected ? root.marker-color.brighter(0.4) : root.marker-color;
        border-width: root.selected ? 2px : 1px;
        border-color: root.selected ? #ffffff : #101014;
    }

    ta := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.dragging = true;
                root.press-mouse-x = self.mouse-x / 1px;
                root.pressed(event.modifiers.shift || event.modifiers.control);
            } else if (event.kind == PointerEventKind.move && root.dragging) {
                // 只沿时间轴拖动；增量 = 光标位移 / 缩放（与节点拖拽一致）
                root.dragged((self.mouse-x / 1px - root.press-mouse-x) / root.view-zoom);
            } else if (event.kind == PointerEventKind.up) {
                if root.dragging {
                    root.released();
                }
                root.dragging = false;
            }
        }
    }
}

export component LineEditor inherits Rectangle {
    Text {
        text: "LineEditor";
        color: green;
        font-size: 20px;

        // 1. 让 Text 元素本身的大小占满父级 (LineEditor)
        width: 100%;
        height: 100%;

        // 2. 使用内置的对齐属性来居中文本内容
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

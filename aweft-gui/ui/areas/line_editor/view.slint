// TODO:
// 实现内容条目的单选与多选拖动调整顺序
// 筛选功能（触发方式思考一下）与排序功能

import { ListView, VerticalBox } from "std-widgets.slint";
import { TableHeader, TableColumn } from "../../widgets/table_header.slint";
import { Theme } from "../../theme/index.slint";
import { TimecodeEditor } from "../../widgets/timecode_editor.slint";
import { SlintKey } from "../../core/types.slint";
import { LineEditorCallbacks } from "../../bridge/callbacks.slint";
import { SlintSubtitleRow, SlintSubtitleRowType } from "../../core/types.slint";
import { SubtitleState } from "../../bridge/state.slint";

export component LineEditor inherits Rectangle {
    // 定义列标题数据
    in property <[TableColumn]> table-columns: [
        {
            title: "折叠/展开",
            width: 70px,
            min-width: 30px,
            horizontal-stretch: 0,
        },
        {
            title: "时间范围",
            width: 250px,
            min-width: 100px,
            horizontal-stretch: 0,
        },
        {
            title: "角色",
            width: 100px,
            min-width: 50px,
            horizontal-stretch: 0,
        },
        {
            title: "内容",
            width: 100px,
            // 占用剩余空间
            min-width: 150px,
            horizontal-stretch: 1,
        },
    ];

    VerticalBox {
        TableHeader {
            height: Theme.data.line-editor.header-height;
            columns: root.table-columns;
            column-clicked(index) => {
                debug("列名被点击", index)
            }
            column-resized(index, diff) => {
                debug("修改列宽度", index, diff)
            }
        }

        ListView {
            for row[idx] in SubtitleState.rows: Rectangle {
                height: Theme.data.line-editor.row-height;

                // 统一使用 HorizontalLayout，确保 Group 和 Event 对齐
                HorizontalLayout {
                    // 第一列：折叠图标 或 缩进竖线
                    Rectangle {
                        width: root.table-columns[0].width;
                        // 超出层级就截断
                        clip: true;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 0px; // 紧凑一点

                            // 1. 先画缩进占位 (根据 depth)
                            // 每一个 depth 占用一定宽度，比如 16px
                            for i in row.depth: Rectangle {
                                width: 16px;
                                height: parent.height;

                                // 可选：在缩进位画竖线
                                Rectangle {
                                    width: 1px;
                                    height: parent.height;
                                    background: #444;
                                    x: 8px; // 居中
                                }
                            }

                            // 折叠按钮

                            if row.row-type == SlintSubtitleRowType.GroupHeader: Rectangle {
                                width: 16px;
                                height: 16px;

                                // 垂直居中
                                y: (parent.height - self.height) / 2;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    transform-rotation: row.collapsed ? -90deg : 0deg;
                                    source: @image-url("../../assets/icons/arrow_drop_down.svg");
                                }

                                TouchArea {
                                    clicked => {
                                        LineEditorCallbacks.toggle-group-collapsed(row.item_id);
                                    }
                                }
                            }

                            // Event 行显示缩进竖线

                            if row.row-type == SlintSubtitleRowType.Event: HorizontalLayout {
                                spacing: 4px;
                                padding-left: 10px;
                                alignment: start;

                                // 循环生成竖线
                                // FIXME: 需要搞明白为啥这里需要减2
                                for i in row.depth - 2: Rectangle {
                                    width: 1px;
                                    height: parent.height;
                                    background: #666;
                                    opacity: 0.5;
                                }
                            }
                        }
                    }

                    // 第二列：时间范围
                    Rectangle {
                        width: root.table-columns[1].width;
                        clip: true;
                        // 组头
                        if row.row-type == SlintSubtitleRowType.GroupHeader: HorizontalLayout {
                            alignment: center;
                            width: 100%;
                            // NOTE: 分组的开始时间和结束时间操作还没构思好
                            Text {
                                text: "~" + row.start-time + "~";
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            // TODO: 左右移动需要实现全组时间移动
                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../../assets/icons/arrow_right_alt.svg");
                            }

                            Text {
                                text: "~" + row.end-time + "~";
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                        if row.row-type == SlintSubtitleRowType.Event: HorizontalLayout {
                            alignment: center;
                            width: 100%;
                            TimecodeEditor {
                                timecode-input(text) => {
                                    LineEditorCallbacks.timecode-input(row.item-id, text, true);
                                }
                                text: row.start-time;
                            }

                            // TODO: 左右移动需要实现开始时间和结束时间同时移动
                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../../assets/icons/arrow_right_alt.svg");
                            }

                            TimecodeEditor {
                                timecode-input(text) => {
                                    LineEditorCallbacks.timecode-input(row.item-id, text, false);
                                }
                                text: row.end-time;
                            }
                        }
                    }

                    // 第三列：角色 (Role)
                    Rectangle {
                        width: root.table-columns[2].width;
                        clip: true;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: self.width / 2;
                            background: green;
                            border-width: 1px;
                            border-color: white;

                            // 居中显示
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 第四列：内容/分组名
                    Rectangle {
                        horizontal-stretch: root.table-columns[3].horizontal-stretch;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;
                            // 由内部控制间距
                            spacing: 0px;

                            // 循环生成每一级深度的占位块
                            for i in row.depth: Rectangle {
                                width: 16px; // 每一级缩进的宽度 (对应之前的 10px * depth)
                                height: parent.height;
                                Rectangle {
                                    width: 6px;
                                    height: parent.height;
                                    x: 5px;
                                    background: #666;
                                    opacity: 0.3;
                                }
                            }
                            Rectangle {
                                width: 6px;
                            }

                            // Group 行的文件夹图标
                            if row.row-type == SlintSubtitleRowType.GroupHeader: Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: row.collapsed ? @image-url("../../assets/icons/folder.svg") : @image-url("../../assets/icons/folder_open.svg");
                                }

                                TouchArea {
                                    clicked => {
                                        LineEditorCallbacks.toggle-group-collapsed(row.item_id);
                                    }
                                }
                            }

                            // 文本内容
                            Text {
                                text: row.row-type == SlintSubtitleRowType.GroupHeader ? row.group-name + " (" + row.total-row-count + ")" : row.text;
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // 行分割线
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #333;
                }
            }
        }
    }
}

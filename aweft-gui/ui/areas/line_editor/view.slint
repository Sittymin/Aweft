// TODO:
// 实现内容条目的单选与多选拖动调整顺序
// 筛选功能（触发方式思考一下）与排序功能

import { ListView, VerticalBox } from "std-widgets.slint";
import { TableHeader, TableColumn } from "../../widgets/table_header.slint";
import { Theme } from "../../theme/index.slint";
import { TimecodeEditor } from "../../widgets/timecode_editor.slint";
import { SlintKey } from "../../core/types.slint";
import { LineEditorCallbacks } from "../../bridge/callbacks.slint";
import {
    SlintSubtitleRow,
    SlintSubtitleRowType,
    SlintSelectionState,
} from "../../core/types.slint";
import { SubtitleState } from "../../bridge/state.slint";

export component LineEditor inherits Rectangle {
    // 定义列标题数据
    in property <[TableColumn]> table-columns: [
        {
            title: "折叠/展开",
            width: 70px,
            min-width: 30px,
            horizontal-stretch: 0,
        },
        {
            title: "时间范围",
            width: 250px,
            min-width: 100px,
            horizontal-stretch: 0,
        },
        {
            title: "角色",
            width: 100px,
            min-width: 50px,
            horizontal-stretch: 0,
        },
        {
            title: "内容",
            width: 100px,
            // 占用剩余空间
            min-width: 150px,
            horizontal-stretch: 1,
        },
    ];

    forward-focus: main-focus;

    private property <int> focused-index: 0;
    private property <length> row-height: Theme.data.line-editor.row-height;

    // 批量编辑相关
    private property <bool> is-batch-editing: false;
    private property <string> batch-text: "";
    private property <string> batch-master-item-id: "";
    private property <bool> is-batch-for-start-time: false;

    function bring-into-view(idx: int) {
        if idx < 0 || idx >= SubtitleState.rows.length {
            debug("[bring-into-view](ui): 出现无效索引");
            return;
        }
        let margin = row_height;

        // NOTE: 往下为负
        // 行的内容坐标（在完整列表中的位置）
        let row_content_y = -(idx * row_height);
        // 行的视口坐标（相对于视口顶部的可视位置）
        let row_vis_y = row_content_y - list-view.viewport-y;

        // === 上边缘处理 ===
        if abs(row_vis_y) < margin && idx > 0 {
            // 向上留一行
            list-view.viewport-y += margin - abs(row_vis_y);
        }
        // 行未完全可见
        else if row_vis_y > 0px {
            // 第一行无需留边距，保证可见即可
            list-view.viewport-y += row_vis_y;
        }

        // 调整后重新计算视口坐标
        let row_vis_y2 = row_content_y - list-view.viewport-y;

        // === 下边缘处理 ===
        // 行坐标 此行高度 预留边缘间隔
        if abs(row_vis_y2 - row_height - margin) > list-view.visible-height && idx + 1 < SubtitleState.rows.length {
            // 向下留一行空白
            list-view.viewport-y -= abs(row_vis_y2 - row_height - margin) - list-view.visible-height;
        } else if abs(row_vis_y2 - row_height) > list-view.visible-height {
            // 最后一行无需留边距
            list-view.viewport-y -= abs(row_vis_y2 - row_height) - list-view.visible-height;
        }
    }

    function exit-batch-edit() {
        is-batch-editing = false;
        batch-text = "";
        batch-master-item-id = "";
    }

    // 跟踪当前焦点行的索引
    main-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.DownArrow) {
                if focused-index + 1 < SubtitleState.rows.length {
                    focused-index += 1;
                    bring-into-view(focused-index);
                    LineEditorCallbacks.select-single(
                        SubtitleState.rows[focused-index].item-id);
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if focused-index > 0 {
                    focused-index -= 1;
                    bring-into-view(focused-index);
                    LineEditorCallbacks.select-single(
                        SubtitleState.rows[focused-index].item-id);
                }
                return accept;
            }
            return reject;
        }
    }

    VerticalBox {
        TableHeader {
            height: Theme.data.line-editor.header-height;
            columns: root.table-columns;
            column-clicked(index) => {
                debug("列名被点击", index)
            }
            column-resized(index, diff) => {
                debug("修改列宽度", index, diff)
            }
        }

        list-view := ListView {
            for row[idx] in SubtitleState.rows: Rectangle {
                height: Theme.data.line-editor.row-height;
                background: row.selected == SlintSelectionState.DirectlySelected ? red : row.selected == SlintSelectionState.IndirectlySelected ? blue : transparent;

                // 点击行空白部分选择
                TouchArea {
                    pointer-event(event) => {
                        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                            main-focus.focus();
                            focused-index = idx;
                            bring-into-view(idx);

                            if event.modifiers.shift {
                                debug("Shift + 左键点击", idx, "行");
                                LineEditorCallbacks.select-range(row.item-id)
                            } else if event.modifiers.control {
                                debug("Ctrl + 左键点击", idx, "行");
                                LineEditorCallbacks.select-toggle(row.item-id)
                            } else {
                                debug("普通左键点击", idx, "行");
                                LineEditorCallbacks.select-single(row.item-id)
                            }
                        }
                        // 右键
                        else if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                            main-focus.focus();
                            focused-index = idx;

                            // 如果右键的不是已选择的项目，那么就单选右键的行
                            if row.selected != SlintSelectionState.DirectlySelected {
                                LineEditorCallbacks.select-single(row.item-id);
                            }

                            // 手动显示菜单
                            list-view-menu-area.show({ x: self.mouse-x, y: self.mouse-y });
                        }
                    }
                }

                // NOTE: 后声明的组件会先接收到事件（所以需要放在 “TouchArea 处理左键” 的后面）
                // 右键菜单
                list-view-menu-area := ContextMenuArea {
                    // 由 TouchArea 捕获控制
                    enabled: false;
                    Menu {
                        MenuItem {
                            title: "增加行";
                            activated => {
                                LineEditorCallbacks.add-line(row.item-id, row.start-time, row.end-time, row.text);
                            }
                        }

                        MenuItem {
                            title: "增加分组";
                            activated => {
                                LineEditorCallbacks.add-group(row.item-id);
                            }
                        }

                        MenuItem {
                            title: "剪切";
                            activated => {
                                LineEditorCallbacks.cut-items();
                            }
                        }

                        MenuItem {
                            title: "复制";
                            activated => {
                                LineEditorCallbacks.copy-items();
                            }
                        }

                        MenuItem {
                            title: "粘贴";
                            activated => {
                                LineEditorCallbacks.paste-items(row.item-id);
                            }
                        }

                        MenuItem {
                            title: "删除";
                            activated => {
                                LineEditorCallbacks.delete-selected-items();
                            }
                        }

                        // TODO: 实现 Action 节点链化编辑与快捷键触发。
                        // 预留右键菜单入口，当前不执行任何操作。
                        MenuItem {
                            title: "上移（TODO）";
                            activated => {
                                debug("TODO: 实现 Action 节点链化编辑与快捷键触发（上移）（应当作为用户自定义的示例）", idx);
                            }
                        }

                        MenuItem {
                            title: "下移（TODO）";
                            activated => {
                                debug("TODO: 实现 Action 节点链化编辑与快捷键触发（下移）", idx);
                            }
                        }

                        // 分隔符
                        MenuSeparator { }

                        if row.row-type == SlintSubtitleRowType.GroupHeader: MenuItem {
                            title: "解散分组（未完成）";
                            activated => {
                                LineEditorCallbacks.ungroups(row.item-id)
                            }
                        }
                    }
                }

                // 统一使用 HorizontalLayout，确保 Group 和 Event 对齐
                HorizontalLayout {
                    // 第一列：折叠图标 或 缩进竖线
                    Rectangle {
                        width: root.table-columns[0].width;
                        // 超出层级就截断
                        clip: true;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 0px;

                            // 缩进占位 (根据 depth)
                            for i in row.depth: Rectangle {
                                width: 16px;
                                height: parent.height;

                                // 在缩进位画竖线
                                Rectangle {
                                    width: 1px;
                                    height: parent.height;
                                    background: #444;
                                    x: parent.width / 2;
                                }
                            }

                            // 折叠按钮
                            if row.row-type == SlintSubtitleRowType.GroupHeader: Rectangle {
                                width: 16px;
                                height: 16px;

                                // 垂直居中
                                y: (parent.height - self.height) / 2;

                                Image {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    transform-rotation: row.collapsed ? -90deg : 0deg;
                                    source: @image-url("../../assets/icons/arrow_drop_down.svg");
                                }

                                TouchArea {
                                    clicked => {
                                        LineEditorCallbacks.toggle-group-collapsed(row.item_id);
                                    }
                                }
                            }
                        }
                    }

                    // 第二列：时间范围
                    Rectangle {
                        width: root.table-columns[1].width;
                        clip: true;
                        // 组头
                        if row.row-type == SlintSubtitleRowType.GroupHeader: HorizontalLayout {
                            alignment: center;
                            width: 100%;
                            // NOTE: 分组的开始时间和结束时间操作还没构思好
                            Text {
                                text: "~" + row.start-time + "~";
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            // TODO: 左右移动需要实现全组时间移动
                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../../assets/icons/arrow_right_alt.svg");
                            }

                            Text {
                                text: "~" + row.end-time + "~";
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                        if row.row-type == SlintSubtitleRowType.Event: HorizontalLayout {
                            alignment: center;
                            width: 100%;
                            TimecodeEditor {
                                increment-timecode(is_batch) => {
                                    LineEditorCallbacks.increment-timecode(row.item-id, true, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                    LineEditorCallbacks.select-single(row.item-id);
                                }
                                decrement-timecode(is_batch) => {
                                    LineEditorCallbacks.decrement-timecode(row.item-id, true, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                    LineEditorCallbacks.select-single(row.item-id);
                                }
                                drag-timecode-start => {
                                    if row.selected != SlintSelectionState.DirectlySelected {
                                        LineEditorCallbacks.select-single(row.item-id);
                                    }
                                }
                                drag-timecode-preview(delta-x, is_batch) => {
                                    LineEditorCallbacks.drag-timecode-preview(row.item-id, true, delta-x, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                }
                                drag-timecode-commit(delta-x, is_batch) => {
                                    LineEditorCallbacks.drag-timecode-commit(row.item-id, true, delta-x, is_batch)
                                }
                                drag-timecode-cancel(is_batch) => {
                                    LineEditorCallbacks.drag-timecode-cancel(row.item-id, true, is_batch)
                                }
                                timecode-input(text) => {
                                    LineEditorCallbacks.timecode-input(row.item-id, true, text, root.is-batch-editing);
                                    root.exit-batch-edit();
                                }
                                edit-activated(is_batch) => {
                                    if is_batch && row.selected == SlintSelectionState.DirectlySelected {
                                        root.is-batch-editing = true;
                                        root.batch-master-item-id = row.item-id;
                                        root.batch-text = row.start-time;
                                        root.is-batch-for-start-time = true;
                                    // 未选中状态下会被选中
                                    } else if row.selected != SlintSelectionState.DirectlySelected {
                                        focused-index = idx;
                                        bring-into-view(idx);
                                        LineEditorCallbacks.select-single(row.item-id)
                                    }
                                }
                                editing-text-changed(text) => {
                                    if root.is-batch-editing {
                                        root.batch-text = text;
                                    }
                                }
                                edit-canceled => {
                                    root.exit-batch-edit()
                                }
                                text: row.start-time;
                                is-passive-editing: root.is-batch-editing && root.is-batch-for-start-time && row.selected == SlintSelectionState.DirectlySelected && root.batch-master-item-id != row.item-id;
                                batch-text: root.batch-text;
                            }

                            // TODO: 左右移动需要实现开始时间和结束时间同时移动
                            Image {
                                width: 20px;
                                height: 20px;
                                source: @image-url("../../assets/icons/arrow_right_alt.svg");
                            }

                            TimecodeEditor {
                                increment-timecode(is_batch) => {
                                    LineEditorCallbacks.increment-timecode(row.item-id, false, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                    LineEditorCallbacks.select-single(row.item-id);
                                }
                                decrement-timecode(is_batch) => {
                                    LineEditorCallbacks.decrement-timecode(row.item-id, false, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                    LineEditorCallbacks.select-single(row.item-id);
                                }
                                drag-timecode-start => {
                                    if row.selected != SlintSelectionState.DirectlySelected {
                                        LineEditorCallbacks.select-single(row.item-id);
                                    }
                                }
                                drag-timecode-preview(delta-x, is_batch) => {
                                    LineEditorCallbacks.drag-timecode-preview(row.item-id, false, delta-x, is_batch);
                                    focused-index = idx;
                                    bring-into-view(idx);
                                }

                                drag-timecode-commit(delta-x, is_batch) => {
                                    LineEditorCallbacks.drag-timecode-commit(row.item-id, false, delta-x, is_batch)
                                }
                                drag-timecode-cancel(is_batch) => {
                                    LineEditorCallbacks.drag-timecode-cancel(row.item-id, false, is_batch)
                                }
                                timecode-input(text) => {
                                    LineEditorCallbacks.timecode-input(row.item-id, false, text, root.is-batch-editing);
                                    root.exit-batch-edit();
                                }
                                edit-activated(is_batch) => {
                                    if is_batch && row.selected == SlintSelectionState.DirectlySelected {
                                        root.is-batch-editing = true;
                                        root.batch-master-item-id = row.item-id;
                                        root.batch-text = row.end-time;
                                        root.is-batch-for-start-time = false;
                                    // 未选中状态下会被选中
                                    } else if row.selected != SlintSelectionState.DirectlySelected {
                                        focused-index = idx;
                                        bring-into-view(idx);
                                        LineEditorCallbacks.select-single(row.item-id)
                                    }
                                }
                                editing-text-changed(text) => {
                                    if root.is-batch-editing {
                                        root.batch-text = text;
                                    }
                                }
                                edit-canceled => {
                                    root.exit-batch-edit()
                                }
                                text: row.end-time;
                                is-passive-editing: root.is-batch-editing && !root.is-batch-for-start-time && row.selected == SlintSelectionState.DirectlySelected && root.batch-master-item-id != row.item-id;
                                batch-text: root.batch-text;
                            }
                        }
                    }

                    // 第三列：角色 (Role)
                    Rectangle {
                        width: root.table-columns[2].width;
                        clip: true;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: self.width / 2;
                            background: green;
                            border-width: 1px;
                            border-color: white;

                            // 居中显示
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    // 第四列：内容/分组名
                    Rectangle {
                        horizontal-stretch: root.table-columns[3].horizontal-stretch;
                        clip: true;
                        HorizontalLayout {
                            alignment: start;
                            // 由内部控制间距
                            spacing: 0px;

                            // 缩进占位 (根据 depth)
                            for i in row.depth: Rectangle {
                                // 每一级缩进的宽度
                                width: 8px;
                                height: parent.height;
                                Rectangle {
                                    width: parent.width / 2;
                                    height: parent.height;
                                    x: 0px;
                                    background: #666;
                                    opacity: 0.3;
                                }
                            }

                            // Group 行的文件夹图标
                            if row.row-type == SlintSubtitleRowType.GroupHeader: Rectangle {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    source: row.collapsed ? @image-url("../../assets/icons/folder.svg") : @image-url("../../assets/icons/folder_open.svg");
                                }

                                TouchArea {
                                    clicked => {
                                        LineEditorCallbacks.toggle-group-collapsed(row.item_id);
                                    }
                                }
                            }

                            // 文本内容
                            Text {
                                text: row.row-type == SlintSubtitleRowType.GroupHeader ? row.group-name + " (" + row.total-row-count + ")" : row.text;
                                color: row.row-type == SlintSubtitleRowType.GroupHeader ? #ffff00 : white;
                                font-weight: row.row-type == SlintSubtitleRowType.GroupHeader ? 700 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // 行分割线
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #333;
                }
            }
        }
    }
}

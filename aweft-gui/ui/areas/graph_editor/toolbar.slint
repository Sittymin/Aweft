// 曲线编辑器标题栏：通用 AreaHeader + 右侧操作按钮（占位）。
// 中区显示当前 Action 名称（来自 AnimationState）。
import { SlintKey, SlintAreaType } from "../../core/types.slint";
import { AnimationState } from "../../bridge/state.slint";
import { AreaHeader } from "../area_header.slint";

export component GraphEditorToolbar inherits Rectangle {
    in property <SlintKey> area-key;
    in property <SlintAreaType> area-type;

    AreaHeader {
        width: 100%;
        height: 100%;
        area-key: root.area-key;
        area-type: root.area-type;
        // 中区：当前 Action 名称
        center-text: AnimationState.action-name;
        // 右侧操作按钮（占位，作用由 Rust 侧数据驱动）
        right-actions: [
            { icon: @image-url("../../assets/icons/graph_editor.svg") },
            { icon: @image-url("../../assets/icons/grid_4x4.svg") },
            { icon: @image-url("../../assets/icons/grid_on.svg") },
        ];
    }
}

import { SlintKey, SlintAreaType } from "../core/types.slint";
import { AreaTypeMetadata } from "../core/area_type_metadata.slint";
import { IconComboBox } from "../widgets/area_type_switcher.slint";
import { AreaCallbacks } from "../bridge/callbacks.slint";
import { Theme } from "../theme/index.slint";

export component AreaHeader inherits Rectangle {
    in property <SlintKey> area-key;
    in property <SlintAreaType> area-type;

    height: Theme.data.area-header.height;
    background: Theme.data.area-header.background;
    HorizontalLayout {
        padding: Theme.data.area-header.padding;
        spacing: Theme.data.area-header.spacing;

        // AreaType 选择器
        IconComboBox {
            // 垂直居中
            y: (parent.height - self.height) / 2;
            current-index: AreaTypeMetadata.area-type-to-index(root.area-type);
            selected(new-index) => {
                AreaCallbacks.switch-area-type(
                    root.area-key, 
                    AreaTypeMetadata.index-to-area-type(new-index));
            }
        }
        
        // 右侧工具栏区域（预留）
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

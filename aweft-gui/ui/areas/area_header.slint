import { SlintKey, AreaType } from "../core/types.slint";
import { AreaTypeMetadata } from "../core/area_type_metadata.slint";
import { IconComboBox } from "../widgets/area_type_switcher.slint";
import { CallbackManager } from "../bridge/callbacks.slint";

export component AreaHeader inherits Rectangle {
    in property <SlintKey> area-key;
    in property <AreaType> area-type;

    height: 35px;
    background: #303030;
    HorizontalLayout {
        padding: 5px;
        spacing: 10px;

        // AreaType 选择器
        IconComboBox {
            // 垂直居中
            y: (parent.height - self.height) / 2;
            current-index: AreaTypeMetadata.area-type-to-index(root.area-type);
            selected(new-index) => {
                CallbackManager.switch-area-type(
                    root.area-key, 
                    AreaTypeMetadata.index-to-area-type(new-index));
            }
        }
        
        // 右侧工具栏区域（预留）
        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

// 时间线（Timeline）编辑器：
//  - 布局参照 NLA 编辑器：左侧行列表 + 顶部时间标尺 + 主画布（泳道 + 时间块）
//  - 数据完全复用字幕行编辑器：行 = SubtitleState.rows（可见行模型，折叠分组的子行
//    不在模型中），折叠/选中全部走 SequenceCallbacks——时间线只是字幕行编辑器的
//    另一种表示形式（左侧列表同一批行，右侧按时间范围定位为块）。
//  - 分组头块 = 组内所有行合并时间范围（min start ~ max end，组内时间范围可重叠）；
//    折叠分组后其下字幕行从可见模型消失（列表与画布同时收起）。
//  - 交互：滚轮仅横向缩放时间轴 / 中键双向平移（纵向随内容 clamp）——与摄影表一致；
//    点击块选中、空白清除选中；左键拖拽框选（时间 × 行，none=替换/shift=加选/ctrl=切换，对齐摄影表）
//  - 画布网格：与摄影表一致用 VerticalGrid 刻度网格
import { SlintSubtitleRow, SlintSubtitleRowType, SlintSelectionState, SlintTimelineSubBlock, SlintSelectionModifier } from "../../core/types.slint";
import { CanvasNavigation } from "../../widgets/canvas_navigation.slint";
import { TimeRuler, VerticalGrid } from "../graph_editor/ruler.slint";
import { TimelineBlock, TimelineSubBlocks } from "elements.slint";
import { TimelinePanel } from "timeline_panel.slint";
import { VideoTimeBarLines } from "../../widgets/video_time_bars.slint";
import { SequenceCallbacks, AnimationCallbacks, VideoCallbacks } from "../../bridge/callbacks.slint";
import { AnimationState, VideoState } from "../../bridge/state.slint";
import { Theme } from "../../theme/index.slint";

export component TimelineEditor inherits Rectangle {
    // 可见行（与字幕行编辑器同一模型：左侧列表一行 = 画布一条泳道；
    // 折叠分组的子行不在模型中）
    in property <[SlintSubtitleRow]> rows;
    // 全部字幕行片段块（Rust 侧全量事件模型）：根级收起时根级泳道据此显示
    in property <[SlintTimelineSubBlock]> timeline-root-blocks: [];
    // 当前时间（播放头，共享 AnimationState.current-time）
    in property <float> current-time;

    // 根级收起展开（本地状态，独立于分组与字幕行编辑器）：
    // 收起后整条时间线折叠为第 0 条根级泳道，显示全部字幕行片段块
    in-out property <bool> root-collapsed: false;
    // 根级栏计数（= 全部字幕行片段块数）
    private property <int> root-count: root.timeline-root-blocks.length;

    // 行列表 / 标尺尺寸（复用 NLA 编辑器主题）
    private property <length> track-list-width: Theme.data.animation-editor.track-list-width;
    private property <length> ruler-height: Theme.data.animation-editor.ruler-height;
    private property <length> row-height: Theme.data.animation-editor.track-row-height;

    // 导航状态（画布、行列表与标尺共享；仅时间轴缩放 + 双向平移）
    private property <float> nav-pan-x: 0.0;
    private property <float> nav-pan-y: 0.0;
    private property <float> nav-zoom: 30.0;

    // 可见时间范围（世界坐标）：标尺刻度槽位与画布块视口裁剪共用
    private property <float> view-time-lo: (0px - root.nav-pan-x * 1px) / (root.nav-zoom * 1px);
    private property <float> view-time-hi: ((root.width - root.track-list-width) - root.nav-pan-x * 1px) / (root.nav-zoom * 1px);

    // 当前焦点视频：选择集合末项优先，无选择时回落主视频。范围遮罩只读取这一行，
    // 避免多个视频的范围颜色同时叠加造成画布混乱。
    private property <int> focus-video-index: VideoState.selected-video >= 0
        ? VideoState.selected-video
        : VideoState.main-video;
    private property <bool> has-focus-video-range: root.focus-video-index >= 0
        && root.focus-video-index < VideoState.time-bars.length
        && VideoState.time-bars[root.focus-video-index].duration > 0.0;
    private property <float> focus-video-duration: root.has-focus-video-range
        ? VideoState.time-bars[root.focus-video-index].duration
        : 0.0;
    private property <color> focus-video-outside-color: root.has-focus-video-range
        ? VideoState.time-bars[root.focus-video-index].color.darker(0.6).with-alpha(0.32)
        : transparent;

    // 纵向滚动范围：只能滚到 [-(内容高-视口高), 0]，内容不足空间时不动（与摄影表一致）。
    // 第 0 行固定为根级行；展开时为根级行 + 全部可见行，收起时仅根级行。
    function content-height-px() -> float {
        return (root.root-collapsed ? 1 : root.rows.length + 1) * (root.row-height / 1px);
    }
    function view-height-px() -> float {
        return canvas.height / 1px;
    }
    function max-scroll-y() -> float {
        return max(0.0, root.content-height-px() - root.view-height-px());
    }
    function scroll-list(delta: float) -> float {
        return min(0.0, max(-root.max-scroll-y(), root.nav-pan-y + delta));
    }

    // 复用字幕行选中回调（SlintSelectionModifier）
    function select-item(item-id: string, modifier: SlintSelectionModifier) {
        SequenceCallbacks.select-row(item-id, modifier);
    }

    // 框选矩形（与摄影表/曲线编辑器一致）
    private property <bool> marquee-visible: false;
    private property <float> marquee-x1: 0.0;
    private property <float> marquee-y1: 0.0;
    private property <float> marquee-x2: 0.0;
    private property <float> marquee-y2: 0.0;

    // 片段拖拽会话（画布级 TouchArea 复用 marquee 机制，同 NLA 编辑器）：
    // 起点命中块（事件或组头）→ 进入整体拖拽（预览/提交/取消），否则画框选
    private property <bool> block-dragging: false;
    private property <string> drag-item-id: "";

    // 空白处框选结束：把选框换算成世界坐标（时间 + 行区间）上报 Rust 选中
    function marquee-select(x1: float, y1: float, x2: float, y2: float, modifier: SlintSelectionModifier) {
        root.marquee-visible = false;
        // 回调传原始点（起点, 当前），先规范化为矩形再转世界坐标
        let x-lo: float = (min(x1, x2) - root.nav-pan-x) / root.nav-zoom;
        let x-hi: float = (max(x1, x2) - root.nav-pan-x) / root.nav-zoom;
        // 第 0 行固定为根级泳道（不占行号），数据行从第 1 条起
        let row-lo: int = floor((min(y1, y2) - root.nav-pan-y - (root.row-height / 1px)) / (root.row-height / 1px));
        let row-hi: int = floor((max(y1, y2) - root.nav-pan-y - (root.row-height / 1px)) / (root.row-height / 1px));
        SequenceCallbacks.timeline-marquee-select(x-lo, x-hi, row-lo, row-hi, modifier);
    }

    // 拖拽/点击共用的起点命中检测（守卫 + 提前返回）：返回 rows 下标，未命中 -1。
    // 第 0 条为根级泳道不参与；折叠态整体不可命中（与点击选中范围一致）。
    function drag-hit-row(px: float, py: float) -> int {
        if root.root-collapsed {
            return -1;
        }
        let lane: int = floor((py - root.nav-pan-y) / (root.row-height / 1px));
        if lane < 1 {
            return -1;
        }
        let row: int = lane - 1;
        if row >= root.rows.length {
            return -1;
        }
        let r: SlintSubtitleRow = root.rows[row];
        let t: float = (px - root.nav-pan-x) / root.nav-zoom;
        if r.end-sec <= r.start-sec || t < r.start-sec || t > r.end-sec {
            return -1;
        }
        return row;
    }

    // marquee 拖动中：首次拖动判定起点是否命中块——命中则进入片段整体拖拽
    // （事件保留现有多选、组头展开子树选中），否则进入框选。
    function nav-marquee-drag(x1: float, y1: float, x2: float, y2: float) {
        if !root.block-dragging && !root.marquee-visible {
            let row: int = root.drag-hit-row(x1, y1);
            if row >= 0 {
                let r: SlintSubtitleRow = root.rows[row];
                root.drag-item-id = r.item-id;
                root.block-dragging = true;
                if r.row-type == SlintSubtitleRowType.GroupHeader {
                    // 组头：选中即展开子树为直接选中（select_single），
                    // 拖动等价于移动组内全部片段
                    SequenceCallbacks.select-row(r.item-id, SlintSelectionModifier.none);
                } else if r.selected == SlintSelectionState.Unselected {
                    // 事件：已在选中集内则保留现有多选（整体移动），否则单选该行
                    SequenceCallbacks.select-row(r.item-id, SlintSelectionModifier.none);
                }
            }
            if !root.block-dragging {
                root.marquee-visible = true;
            }
        }
        if root.block-dragging {
            // delta-x = 像素位移 / 缩放 → 世界时间秒；Rust 预览整体平移 start/end
            SequenceCallbacks.timeline-block-dragged(root.drag-item-id, (x2 - x1) / root.nav-zoom);
        } else if root.marquee-visible {
            root.marquee-x1 = min(x1, x2);
            root.marquee-y1 = min(y1, y2);
            root.marquee-x2 = max(x1, x2);
            root.marquee-y2 = max(y1, y2);
        }
    }

    // marquee 结束（松开）：片段拖拽提交或框选选中
    function nav-marquee-end(x1: float, y1: float, x2: float, y2: float, modifier: SlintSelectionModifier) {
        if root.block-dragging {
            // 与预览同源：原始点（起点, 当前）→ 带符号累计位移
            SequenceCallbacks.timeline-block-drag-commit(root.drag-item-id, (x2 - x1) / root.nav-zoom);
            root.block-dragging = false;
        } else if root.marquee-visible {
            root.marquee-select(x1, y1, x2, y2, modifier);
        }
    }

    // 左侧行列表
    panel := TimelinePanel {
        x: 0;
        y: 0;
        width: root.track-list-width;
        height: root.height;
        rows: root.rows;
        pan-y: root.nav-pan-y;
        row-height: root.row-height;
        // 顶部占位 = 标尺高度，列表第一行与画布第一泳道对齐
        top-offset: root.ruler-height;
        root-collapsed: root.root-collapsed;
        root-count: root.root-count;
        scrolled(delta) => {
            root.nav-pan-y = root.scroll-list(delta);
        }
        toggle-root-collapsed() => {
            root.root-collapsed = !root.root-collapsed;
        }
    }

    // 顶部时间标尺（位于画布上方、行列表右侧）
    TimeRuler {
        x: root.track-list-width;
        y: 0;
        width: root.width - root.track-list-width;
        height: root.ruler-height;
        view-lo: root.view-time-lo;
        view-hi: root.view-time-hi;
        zoom-x: root.nav-zoom;
        pan-x: root.nav-pan-x;
        current-time: root.current-time;
        time-picked(time) => {
            AnimationCallbacks.set-current-time(time);
        }
        // 多视频控制时间条（内嵌于标尺：点击选中视频、拖拽 seek）
        video-bars: VideoState.time-bars;
        active-video-index: root.focus-video-index;
        video-bar-pressed(index, is-batch) => {
            VideoCallbacks.time-bar-pressed(index, is-batch);
        }
        video-bar-dragged(time) => {
            VideoCallbacks.time-bar-dragged(time);
        }
        video-bar-released(index) => {
            VideoCallbacks.time-bar-released(index);
        }
    }

    // 主画布
    canvas := Rectangle {
        x: root.track-list-width;
        y: root.ruler-height;
        width: root.width - root.track-list-width;
        height: root.height - root.ruler-height;
        clip: true;
        background: Theme.data.animation-editor.canvas-background;

        // 根级泳道背景（第 0 条；与其余泳道交替明暗）
        Rectangle {
            y: root.nav-pan-y * 1px;
            x: 0px;
            width: 100%;
            height: root.row-height;
            background: Theme.data.animation-editor.lane-even;
        }

        // 行泳道背景（交替明暗；网格画在其上，与摄影表通道行同构；
        // 第 1 条起对应根级以下的可见行，根级收起时隐藏）
        for r[i] in root.rows: Rectangle {
            visible: !root.root-collapsed;
            y: (i + 1) * root.row-height + root.nav-pan-y * 1px;
            x: 0px;
            width: 100%;
            height: root.row-height;
            background: Math.mod(i + 1, 2) == 0
                ? Theme.data.animation-editor.lane-even
                : Theme.data.animation-editor.lane-odd;
        }

        // 垂直时间线（与标尺刻度对齐；固定槽位即时计算，同摄影表/曲线编辑器）
        VerticalGrid {
            width: 100%;
            height: 100%;
            view-lo: root.view-time-lo;
            view-hi: root.view-time-hi;
            zoom-x: root.nav-zoom;
            pan-x: root.nav-pan-x;
            line-color: Theme.data.animation-editor.grid-color;
            minor-line-color: Theme.data.animation-editor.grid-minor-color;
        }

        // 当前焦点视频时长之外的区域：沿用该视频的彩虹色，但加深并半透明叠加。
        // 与 NLA/Dope Sheet 的范围外遮罩同层级，片段、交互和播放头仍绘制在其上。
        Rectangle {
            visible: root.has-focus-video-range;
            x: 0px;
            width: max(0px, min(parent.width, root.nav-pan-x * 1px));
            height: 100%;
            background: root.focus-video-outside-color;
        }
        Rectangle {
            visible: root.has-focus-video-range;
            x: max(0px, root.focus-video-duration * root.nav-zoom * 1px
                + root.nav-pan-x * 1px);
            width: max(0px, parent.width - max(0px,
                root.focus-video-duration * root.nav-zoom * 1px
                    + root.nav-pan-x * 1px));
            height: 100%;
            background: root.focus-video-outside-color;
        }

        // 根级泳道（第 0 条）：
        //   - 展开：空条带（仅对齐根级栏；其余行各自显示自己的块）
        //   - 收起：用全部字幕行片段块（与分组收起共用 TimelineSubBlocks 渲染）
        Rectangle {
            x: 0px;
            y: root.nav-pan-y * 1px;
            width: 100%;
            height: root.row-height;

            if root.root-collapsed: TimelineSubBlocks {
                blocks: root.timeline-root-blocks;
                view-lo: root.view-time-lo;
                view-hi: root.view-time-hi;
                view-zoom: root.nav-zoom;
                pan-x: root.nav-pan-x;
                lane-height: root.row-height;
            }
        }

        // 时间块（根级以下每条泳道一个）：
        //   - 展开组头 / 字幕行：单个块（组头块 = 组内所有行合并范围）
        //   - 折叠组头：渲染组内所有字幕行的子块（各自时间范围，可重叠）——
        //     原本各自独立行的部分统一到组头一行
        for r[i] in root.rows: Rectangle {
            visible: !root.root-collapsed;
            x: 0px;
            y: (i + 1) * root.row-height + root.nav-pan-y * 1px;
            width: 100%;
            height: root.row-height;

            if r.row-type == SlintSubtitleRowType.GroupHeader && r.collapsed: TimelineSubBlocks {
                blocks: r.child-blocks;
                view-lo: root.view-time-lo;
                view-hi: root.view-time-hi;
                view-zoom: root.nav-zoom;
                pan-x: root.nav-pan-x;
                lane-height: root.row-height;
            }
            if !(r.row-type == SlintSubtitleRowType.GroupHeader && r.collapsed): Rectangle {
                width: 100%;
                height: 100%;
                if r.end-sec > r.start-sec
                    && r.end-sec >= root.view-time-lo && r.start-sec <= root.view-time-hi: TimelineBlock {
                    name: r.row-type == SlintSubtitleRowType.GroupHeader
                        ? r.group-name + " (" + r.total-row-count + ")"
                        : r.text;
                    row-type: r.row-type == SlintSubtitleRowType.GroupHeader
                        ? SlintSubtitleRowType.GroupHeader
                        : SlintSubtitleRowType.Event;
                    start: r.start-sec;
                    end: r.end-sec;
                    selection-state: r.selected;
                    view-zoom: root.nav-zoom;
                    pan-x: root.nav-pan-x;
                    lane-height: root.row-height;
                }
            }
        }

        // 导航（背景交互，位于泳道之下；与摄影表一致：滚轮仅横向缩放 /
        // 中键双向平移但纵向随内容 clamp）。块点击由画布级 TouchArea 处理：
        // 块自身不带 TouchArea（Slint TouchArea 会吞任意按钮按下、含中键），
        // 因此中键平移在块上方同样可用。命中检测在 Slint 侧完成（不加 Rust 回调）。
        nav := CanvasNavigation {
            pan-x <=> root.nav-pan-x;
            pan-y <=> root.nav-pan-y;
            zoom-x <=> root.nav-zoom;
            lock-y-zoom: true;
            max-zoom: 12000.0;
            zoom-step: 1.5;
            clamp-pan-y: true;
            clamp-pan-y-min: -root.max-scroll-y();
            clamp-pan-y-max: 0.0;
            marquee-enabled: true;
            marquee-dragged(x1, y1, x2, y2) => {
                root.nav-marquee-drag(x1, y1, x2, y2);
            }
            marquee-done(x1, y1, x2, y2, modifier) => {
                root.nav-marquee-end(x1, y1, x2, y2, modifier);
            }
            background-pressed(modifier) => {
                // 点击：按位置命中块则选中（复用字幕行选中回调），空白清除选中。
                // 命中规则与拖拽起点共用 drag-hit-row（第 0 条根级泳道/折叠态不参与）。
                let row: int = root.drag-hit-row(nav.mouse-x / 1px, nav.mouse-y / 1px);
                if row >= 0 {
                    root.select-item(root.rows[row].item-id, modifier);
                    return;
                }
                // 空白处（未命中块/根级泳道/行外）→ 清除选中
                SequenceCallbacks.timeline-deselect-all();
            }
            cancel-pressed => {
                if root.block-dragging {
                    SequenceCallbacks.timeline-block-drag-cancel(root.drag-item-id);
                    root.block-dragging = false;
                }
                root.marquee-visible = false;
            }
        }

        // 框选矩形（与摄影表/曲线编辑器一致，与 dope_sheet 同风格）
        Rectangle {
            visible: root.marquee-visible;
            x: root.marquee-x1 * 1px;
            y: root.marquee-y1 * 1px;
            width: (root.marquee-x2 - root.marquee-x1) * 1px;
            height: (root.marquee-y2 - root.marquee-y1) * 1px;
            background: Theme.data.animation-editor.marquee-fill;
            border-width: 1px;
            border-color: Theme.data.animation-editor.marquee-border;
        }

        // 多视频彩色时间线（置顶绘制在播放头之前，不拦截事件）
        VideoTimeBarLines {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            view-lo: root.view-time-lo;
            view-hi: root.view-time-hi;
            zoom-x: root.nav-zoom;
            pan-x: root.nav-pan-x;
        }

        // 当前时间线（播放头，置顶但不拦截事件）
        Rectangle {
            x: root.current-time * root.nav-zoom * 1px + root.nav-pan-x * 1px;
            y: 0px;
            width: 1px;
            height: 100%;
            background: Theme.data.animation-editor.playhead;
        }
    }
}

import { SplitPreviewOverlay, SplitPreviewOverlayData, JoinHighlightOverlayData, CloseAreaOverlayData, JoinHighlightOverlay, CloseAreaOverlays } from "overlay.slint";
import { VideoPlayer } from "video.slint";

export struct SlintKey {
    // 低32位：区域索引
    key-index: int,
    // 高32位：区域版本
    key-version: int,
}

struct ScrAreaData {
    area_key: SlintKey,
    x: length,
    y: length,
    width: length,
    height: length,
    actionzone-side-length: length,
}

export enum ActionZoneCorner {
    top-left,
    top-right,
    bottom-left,
    bottom-right
}


export struct ScrEdgeDisplayData {
    x: length,
    y: length,
    width: length,
    height: length,
    active: bool,
}

export struct ScrEdgeTouchAreaData {
    // TouchArea 的稳定位置（避免频繁更新）
    x: length,
    y: length,
    width: length,
    height: length,
    vert_keys: [SlintKey]
}

component ScrEdgeDisplay inherits Rectangle {
    in property <ScrEdgeDisplayData> data;
    animate background { duration: 250ms; }
    background: data.active ? rgba(255,0,0,1) : rgba(0,255,0,0.5);
    x: data.x;
    y: data.y;
    z: 100;
    width: data.width;
    height: data.height;
}

component ScrEdgeTouchArea inherits TouchArea {
    in property <ScrEdgeTouchAreaData> touch-area-data;
    property <bool> is-dragging;
    x: touch-area-data.x;
    y: touch-area-data.y;
    width: touch-area-data.width;
    height: touch-area-data.height;
    changed has-hover => {
        if (self.has-hover) {
            // 指针进入区域时的回调
            // TODO: 添加一个回调用于将对应ScrEdgeDisplayData active设置
            debug("鼠标悬停进入");
        } else {
            // 指针离开区域时的回调
            debug("鼠标悬停离开");
        }
    }
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
            // 开始拖拽
            self.is-dragging = true;
        } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.is-dragging) {
            // 松开时触发结束回调
            CallbackManager.edge-drag-end(false);
            self.is-dragging = false;
        } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && root.is-dragging) {
            CallbackManager.edge-drag-end(true);
            self.is-dragging = false;
        } else if (event.kind == PointerEventKind.move && root.is-dragging) {
            CallbackManager.edge-drag(root.touch-area-data.vert_keys, self.mouse-x, self.mouse-y);
        }
    }
}

export global CallbackManager {
    // 定义回调 - 使用拆分的键值
    callback actionzone-drag(area-key: SlintKey, corner: ActionZoneCorner, offset-x: length, offset-y: length);
    callback actionzone-drag-end(area-key: SlintKey, is-cancel: bool);
    callback edge-drag-end(is-cancel: bool);
    callback edge-drag(vert-keys: [SlintKey], offset-x: length, offset-y: length);
}

component ActionZone inherits Rectangle {
    in property <ActionZoneCorner> position;
    border-width: 2px;
    property <bool> is-dragging;

    callback actionzone-drag(corner: ActionZoneCorner, x: length, y: length);
    callback actionzone-drag-end(is-cancel: bool);

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                // 开始拖拽
                root.is-dragging = true;
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.is-dragging) {
                // 松开时触发结束回调
                root.actionzone-drag-end(false);
                root.is-dragging = false;
            } else if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right && root.is-dragging) {
                root.actionzone-drag-end(true);
                root.is-dragging = false;
            } else if (event.kind == PointerEventKind.move && root.is-dragging) {
                root.actionzone-drag(root.position, self.mouse-x, self.mouse-y);
            }
        }
    }
}

export global VideoState {
    in property <image> current-video-frame;
}

component SlintScrArea inherits Rectangle {
    in property <SlintKey> area-key;
    in property <length> container-x;
    in property <length> container-y;
    in property <length> container-width;
    in property <length> container-height;
    in property <length> actionzone-side-length;

    x: container-x;
    y: container-y;
    width: container-width;
    height: container-height;
    border-width: 2px;
    border-color: #00FFFF; // 青色 - 区域边框
    VideoPlayer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        video-frame: VideoState.current-video-frame;
        // video-frame: @image-url("/home/Sittymin/Pictures/[VCB-Studio] To LOVE-Ru Darkness [02][Ma10p_1080p][x265_flac]-00:05:03.png");
    }

    ActionZone {
        x: 0;
        y: 0;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.top-left;
        border-color: #FF0080; // 亮粉色 - 左上角
        actionzone-drag(corner, mouse-x, mouse-y) => {
            CallbackManager.actionzone-drag(root.area-key, corner, mouse-x, mouse-y);
        }
        actionzone-drag-end(is-cancel) => {
            CallbackManager.actionzone-drag-end(root.area-key, is-cancel)
        }
    }

    ActionZone {
        x: container-width - actionzone-side-length;
        y: 0;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.top-right;
        border-color: #0080FF; // 亮蓝色 - 右上角
        actionzone-drag(corner, mouse-x, mouse-y) => {
            CallbackManager.actionzone-drag(root.area-key, corner, mouse-x, mouse-y);
        }
        actionzone-drag-end(is-cancel) => {
            CallbackManager.actionzone-drag-end(root.area-key, is-cancel)
        }
    }

    ActionZone {
        x: container-width - actionzone-side-length;
        y: container-height - actionzone-side-length;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.bottom-right;
        border-color: #FF8000; // 亮橙色 - 右下角
        actionzone-drag(corner, mouse-x, mouse-y) => {
            CallbackManager.actionzone-drag(root.area-key, corner, mouse-x, mouse-y);
        }
        actionzone-drag-end(is-cancel) => {
            CallbackManager.actionzone-drag-end(root.area-key, is-cancel)
        }
    }

    ActionZone {
        x: 0;
        y: container-height - actionzone-side-length;
        width: actionzone-side-length;
        height: actionzone-side-length;
        position: ActionZoneCorner.bottom-left;
        border-color: #FFFF00; // 亮黄色 - 左下角
        actionzone-drag(corner, mouse-x, mouse-y) => {
            CallbackManager.actionzone-drag(root.area-key, corner, mouse-x, mouse-y);
        }
        actionzone-drag-end(is-cancel) => {
            CallbackManager.actionzone-drag-end(root.area-key, is-cancel)
        }
    }
}

export component MainWindow inherits Window {
    in property <[ScrAreaData]> scrareas: [];
    in property <[ScrEdgeDisplayData]> scredgedisplays: [];
    in property <[ScrEdgeTouchAreaData]> scredgetouchareas: [];
    in property <length> border-width: 2px;
    in property <bool> show-split-preview-overlay: false;
    in property <SplitPreviewOverlayData> split-preview-overlay-data;
    in property <bool> show-join-highlight-overlay: false;
    in property <JoinHighlightOverlayData> join-highlight-overlay-data;
    in property <bool> show-close-area-overlays: false;
    in property <[CloseAreaOverlayData]> close-area-overlay-datas;

    for scrarea[index] in scrareas: SlintScrArea {
        area-key: scrarea.area-key;
        container-x: scrarea.x;
        container-y: scrarea.y;
        container-width: scrarea.width;
        container-height: scrarea.height;
        actionzone-side-length: scrarea.actionzone-side-length;
    }

    for scredgedisplay[index] in scredgedisplays: ScrEdgeDisplay {
        data: scredgedisplay;
    }
    for scredgetoucharea[index] in scredgetouchareas: ScrEdgeTouchArea {
        touch-area-data: scredgetoucharea;
    }

    if show-split-preview-overlay: split-preview-overlay := SplitPreviewOverlay {
        data: split-preview-overlay-data;
        border-width: border-width;
    }
    if show-join-highlight-overlay: join-highlight-overlay := JoinHighlightOverlay {
        data: join-highlight-overlay-data;
    }
    if show-close-area-overlays: close-area-overlays := CloseAreaOverlays {
        x: 0px;
        y: 0px;
        datas: close-area-overlay-datas;
    }
}

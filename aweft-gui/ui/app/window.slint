import {
    SplitPreviewOverlay,
    SplitPreviewOverlayData,
} from "../screen/overlays/split_preview.slint";
import {
    JoinHighlightOverlay,
    JoinHighlightOverlayData,
} from "../screen/overlays/join_highlight.slint";
import {
    CloseAreaOverlays,
    CloseAreaOverlayData,
} from "../screen/overlays/close_area.slint";
import { ScrEdgeDisplay } from "../screen/edges/edge_display.slint";
import { ScrEdgeTouchArea } from "../screen/edges/edge_touch_area.slint";
import { SlintScrArea } from "../screen/area_container.slint";
import { SubtitleOverlay } from "../areas/subtitle.slint";
import { DismissOverlay } from "../widgets/dismiss_overlay.slint";
import { MediaPicker } from "../areas/media_picker.slint";
import {
    ScrEdgeTouchAreaDisplayData,
    ScrEdgeTouchAreaData,
    ScrAreaData,
} from "../core/types.slint";
import { MenuBar } from "menu_bar.slint";
import {
    AnimationState,
    DismissOverlayState,
    NodeGraphState,
    OverlayState,
    SubtitleState,
    VideoState,
    AudioState,
    MediaPickerState,
    CollabUiState,
} from "../bridge/state.slint";
import {
    DragCallbacks,
    AreaCallbacks,
    SequenceCallbacks,
    NodeGraphCallbacks,
    AnimationCallbacks,
    VideoCallbacks,
    AudioCallbacks,
    MediaPickerCallbacks,
    CollabCallbacks,
} from "../bridge/callbacks.slint";
import { AreaTypeMetadata } from "../core/area_type_metadata.slint";
import { Theme } from "../theme/index.slint";

// 重新导出全局对象，使其在 Rust 侧可见
export {
    VideoState,
    AudioState,
    SubtitleState,
    OverlayState,
    NodeGraphState,
    DismissOverlayState,
    AnimationState,
    DragCallbacks,
    AreaCallbacks,
    SequenceCallbacks,
    NodeGraphCallbacks,
    AnimationCallbacks,
    VideoCallbacks,
    AudioCallbacks,
    AreaTypeMetadata,
    MediaPickerState,
    MediaPickerCallbacks,
    CollabUiState,
    CollabCallbacks,
    Theme
}

// 主窗口组件
export component MainWindow inherits Window {
    // 四周系统栏的厚度（逻辑像素）。Android 上窗口是全屏的，状态栏与导航条盖在
    // 内容上、且那一圈的触摸归系统，Rust 侧读这四个值把布局整体内缩；桌面恒为 0。
    out property <length> safe-inset-left: root.safe-area-insets.left;
    // 顶栏属于应用内容，不应覆盖 Area；将其与系统安全区合并，Rust 布局据此
    // 从顶栏下方创建 screen map。其余三边只保留系统安全区。
    out property <length> safe-inset-top: root.safe-area-insets.top + root.menu-bar-height;
    out property <length> safe-inset-right: root.safe-area-insets.right;
    out property <length> safe-inset-bottom: root.safe-area-insets.bottom;

    in property <[ScrAreaData]> scr-areas: [];
    in property <[ScrEdgeTouchAreaDisplayData]> scr-edge-touch-areas-displays: [];
    in property <[ScrEdgeTouchAreaData]> scr-edge-touch-areas: [];

    for scr-area[index] in scr-areas: SlintScrArea {
        area-key: scr-area.area_key;
        area-type: scr-area.area_type;
        container-x: scr-area.x;
        container-y: scr-area.y;
        container-width: scr-area.width;
        container-height: scr-area.height;
        actionzone-side-length: scr-area.actionzone-side-length;
        plugin-id: scr-area.plugin-id;
        plugin-factory: scr-area.plugin-factory;
    }
    for scr-edge-touch-areas-display[index] in scr-edge-touch-areas-displays: ScrEdgeDisplay {
        data: scr-edge-touch-areas-display;
    }
    for scr-edge-touch-area[index] in scr-edge-touch-areas: ScrEdgeTouchArea {
        touch-area-data: scr-edge-touch-area;
    }

    if OverlayState.show-split-preview-overlay: split-preview-overlay := SplitPreviewOverlay {
        data: OverlayState.split-preview-overlay-data;
        border-width: Theme.data.split-preview.border-width;
    }
    if OverlayState.show-join-highlight-overlay: join-highlight-overlay := JoinHighlightOverlay {
        data: OverlayState.join-highlight-overlay-data;
    }
    if OverlayState.show-close-area-overlays: close-area-overlays := CloseAreaOverlays {
        datas: OverlayState.close-area-overlay-datas;
    }

    // 收起遮罩（内嵌输入框聚焦 / 右键菜单打开时）：挖去浮层自身占用的区域，
    // 点其余任意处即收起（输入框失焦、菜单关闭由各自联动完成）
    if DismissOverlayState.active: DismissOverlay {
        hole-x: DismissOverlayState.hole-x;
        hole-y: DismissOverlayState.hole-y;
        hole-width: DismissOverlayState.hole-width;
        hole-height: DismissOverlayState.hole-height;
        dismissed => {
            DismissOverlayState.active = false;
        }
    }

    // 媒体选择弹层（仅 Android 由 Rust 驱动显隐）：盖在字幕层之下、内容之上，
    // 点行走 pick-media，点遮罩/取消走 cancel-media。
    if MediaPickerState.visible: MediaPicker {
        items: MediaPickerState.items;
        pick(index) => {
            MediaPickerCallbacks.pick-media(index);
        }
        cancel() => {
            MediaPickerCallbacks.cancel-media();
        }
    }

    // 顶栏操作菜单：左区文件/编辑/帮助（占位），右区协作按钮 + 弹出面板。
    // y 起始于系统安全区下方，避免被 Android 状态栏遮挡。
    menu-bar := MenuBar {
        x: 0px;
        y: root.safe-area-insets.top;
        width: 100%;
    }
    // 顶栏高度会合并到 safe-inset-top，供 Rust 布局预留。
    out property <length> menu-bar-height: menu-bar.bar-height;

    // 字幕覆盖层，显示在所有内容之上
    // HACK: 目前还不是相对于视频Area来说的
    in property <length> subtitle-x: 0px;
    in property <length> subtitle-y: 0px;
    subtitle-overlay := SubtitleOverlay {
        x: subtitle-x;
        y: subtitle-y;
        width: SubtitleState.current-subtitle-frame.width * 1px;
        height: SubtitleState.current-subtitle-frame.height * 1px;
        border-width: Theme.data.subtitle-overlay.border-width;
        border-color: Theme.data.subtitle-overlay.border-color;
        subtitle-frame: SubtitleState.current-subtitle-frame;
    }
}

export component SubtitleOverlay {
    in property <image> subtitle-frame;
    in property <length> subtitle-x: 0px;
    in property <length> subtitle-y: 0px;
    
    // 字幕容器
    if subtitle-frame.width * 1px > 0px && subtitle-frame.height * 1px > 0px: Rectangle {
        x: subtitle-x;
        y: subtitle-y;
        width: subtitle-frame.width * 1px;
        height: subtitle-frame.height * 1px;
        
        Image {
            source: subtitle-frame;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
            image-fit: preserve;
        }
    }
}

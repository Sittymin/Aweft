export component VideoPlayer {
    in property <image> video-frame <=> image.source;
    image := Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-tiling: none;
        vertical-tiling: none;
        image-fit: contain;
        // image-fit: fill;
    }
}

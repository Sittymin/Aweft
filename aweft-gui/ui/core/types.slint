export struct SlintKey {
    // 低32位：区域索引
    key-index: int,
    // 高32位：区域版本
    key-version: int,
}

export enum SlintAreaType {
    line-editor,
    viewport,
    // 时间线（Timeline）：像视频轨道一样使用长方形填充占用的时间部分
    timeline,
    // 样式链（node_graph）
    style-graph-editor,
    // 应用图（application_graph）
    app-graph-editor,
    // 曲线编辑器（animation::Action/FCurve）
    graph-editor,
    // 摄影表（Dope Sheet：每通道一行按时间铺开关键帧）
    dope-sheet,
    // NLA 编辑器（AnimData：非破坏性动画轨道/片断）
    nla-editor,
    // 音频波形（当前使用固定分桶的占位采样）
    audio-waveform,
    // 插件面板：Area 类型本身不区分是哪个插件，插件 id 在 ScrAreaData.plugin-id，
    // 面板内容由 ScrAreaData.plugin-factory 现取现嵌
    plugin,
}

// 单个时间桶的 min/max/rms 包络（Audacity 式三值；空桶/静音段全 0）。
export struct SlintWaveformBucket {
    min: float,
    max: float,
    rms: float,
}

export struct SlintAudioWaveform {
    duration: float,
}

export enum AudioTrackWaveformStatus {
    unprocessed,
    processing,
    completed,
}

export struct SlintAudioTrack {
    stream-id: string,
    label: string,
    language: string,
    channels: int,
    channel-layout: string,
    channel-mask: string,
    codec: string,
    caps: string,
    sample-rate: int,
    bit-depth: int,
    bitrate: int,
    max-bitrate: int,
    artist: string,
    album: string,
    comment: string,
    description: string,
    encoder: string,
    encoded-by: string,
    waveform: SlintAudioWaveform,
    waveform-status: AudioTrackWaveformStatus,
}

// 节点图类型：样式图（node_graph）与应用图（application_graph）
export enum GraphType {
    style-graph,
    app-graph,
}

// 鼠标选择修饰键：无修饰、Shift 区间扩展、Ctrl 切换。
export enum SlintSelectionModifier {
    none,
    shift,
    ctrl,
}

export struct IconAndText {
    icon: image,
    text: string,
}

// Area 切换菜单里"插件"一列的一项：只有 id 与名字，图标由
// AreaTypeMetadata.plugin-icon 统一给（`@image-url` 是 .slint 侧的字面量，
// Rust 造不出 image，也就不必为每一项带一个）。
export struct PluginAreaItem {
    id: string,
    name: string,
}

export struct ScrAreaData {
    area_key: SlintKey,
    area_type: SlintAreaType,
    x: length,
    y: length,
    width: length,
    height: length,
    actionzone-side-length: length,
    // area_type == plugin 时是插件 id，其余类型为空串
    plugin-id: string,
    // 面板的组件工厂（按插件 id 缓存，克隆同一份指针相等，投影重算不重建面板）；
    // 非插件 Area 为默认值（空工厂）
    plugin-factory: component-factory,
}

export enum ActionZoneCorner {
    top-left,
    top-right,
    bottom-left,
    bottom-right
}


export struct ScrEdgeTouchAreaDisplayData {
    x: length,
    y: length,
    width: length,
    height: length,
    active: bool,
    edge_keys: [SlintKey],
}

export struct ScrEdgeTouchAreaData {
    // TouchArea 的稳定位置（避免频繁更新）
    x: length,
    y: length,
    width: length,
    height: length,
    // 可能同一水平/垂直并且连续的两条边合并了
    edge_keys: [SlintKey],
    vert_keys: [SlintKey]
}

export enum SlintSubtitleRowType {
    Event,
    GroupHeader,
}

export enum SlintSelectionState {
    Unselected,
    DirectlySelected,
    // 间接选中只适用于 选中分组内所有 items 的时候分组头的状态
    IndirectlySelected, // 间接选中 For example: 在没有选中 groupheader 的时候选中所有内部 items
}

// 分组头折叠时画布上显示的"字幕行子块"：组内每个字幕行（递归）一块，
// 按各自时间范围定位（组内时间可重叠）。展开时子行各自占泳道，此列表忽略。
export struct SlintTimelineSubBlock {
    // 字幕行 ID（折叠时命中子块可选中/改时间范围，复用 line_editor 时间回调）
    item-id: string,
    // 字幕行文本
    name: string,
    start-sec: float,
    end-sec: float,
}

export struct SlintSubtitleRow {
    // === 通用字段 ===
    row_type: SlintSubtitleRowType,
    depth: int,
    // 存储祖先 group_id，用于判断自身是否属于被折叠的
    ancestor_groups: [string],
    start_time: string,
    end_time: string,
    // 时间范围（秒，浮点）：与 start_time/end_time 字符串同源，供时间线画布按时间轴定位块。
    // 分组头 = 组内所有行合并范围（min start ~ max end），空组为 0。
    start-sec: float,
    end-sec: float,
    // 分组头：折叠时画布组头泳道渲染的字幕行子块（组内所有字幕行递归）；非分组忽略
    child-blocks: [SlintTimelineSubBlock],
    item_id: string,
    // 是否被选中
    selected: SlintSelectionState,
    // 缓存的分组内部 item 数 (用于快速局部更新)
    // 分组头，事件头也算一个
    total_row_count: int,

    // === 事件数据字段 (row_type == Event 时有效) ===
    text: string,
    // TODO: 注释、样式链和其他元数据在侧边栏实现
    // TODO: 在节点链当中实现
    // layer: int,
    // WARNING: 这个小眼睛应当优先实现（可见性）
    visable: bool,

    // === 分组数据字段 (row_type == GroupHead 时有效) ===
    group_name: string,
    collapsed: bool,
}

// 每个视频会话在面板中显示的控制时间条：独立位置（彩虹色）+ 选中/主视频标识。
// 曲线/摄影表/NLA/时间线的 TimeRuler 叠加显示（TimeRuler 内置于标尺，播放头控制柄
// 绘制在其上，不遮挡显示时间的框框）。
export struct SlintVideoTimeBar {
    // 视频文件名，用作其附带音频轨的波形选择标签。
    label: string,
    // 该视频当前播放位置（秒）
    time: float,
    // 该视频总时长（秒）；尚未由媒体管线发布时为 0
    duration: float,
    // 彩虹色（与曲线编辑器通道同款调色板，按下标取色循环）
    color: color,
    // 是否当前选中（选中时时间条描边）
    selected: bool,
    // 是否主视频（视觉加粗标识；无选中时 seek 目标）
    is-main: bool,
    // 是否显式静音该视频（视口用额外外框表示）
    muted: bool,
}

// 视频会话在视口世界坐标中的位置（级联错开落点；非主视频可拖拽移动）
export struct SlintVideoPos {
    x: float,
    y: float,
}

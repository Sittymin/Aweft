export struct SlintKey {
    // 低32位：区域索引
    key-index: int,
    // 高32位：区域版本
    key-version: int,
}

export enum SlintAreaType {
    line-editor,
    viewport,
}

export struct IconAndText {
    icon: image,
    text: string,
}

export struct ScrAreaData {
    area_key: SlintKey,
    area_type: SlintAreaType,
    x: length,
    y: length,
    width: length,
    height: length,
    actionzone-side-length: length,
}

export enum ActionZoneCorner {
    top-left,
    top-right,
    bottom-left,
    bottom-right
}


export struct ScrEdgeDisplayData {
    x: length,
    y: length,
    width: length,
    height: length,
    active: bool,
}

export struct ScrEdgeTouchAreaData {
    // TouchArea 的稳定位置（避免频繁更新）
    x: length,
    y: length,
    width: length,
    height: length,
    vert_keys: [SlintKey]
}

export enum SlintSubtitleRowType {
    Event,
    GroupHeader,
}

export struct SlintSubtitleRow {
    // === 通用字段 ===
    row_type: SlintSubtitleRowType,
    depth: int,
    // 存储祖先 group_id，用于判断自身是否属于被折叠的
    ancestor_groups: [string],
    start_time: string,
    end_time: string,
    item_id: string,
    // 是否被选中
    selected: bool,

    // === 事件数据字段 (row_type == Event 时有效) ===
    text: string,
    style: string,
    layer: int,
    is_comment: bool,

    // === 分组数据字段 (row_type == GroupHead 时有效) ===
    group_name: string,
    collapsed: bool,
    // 缓存的分组内部 item 数 (用于快速局部更新)
    // 分组头也算一个
    total_row_count: int,
}


// 动画编辑器（曲线编辑器 + NLA 编辑器）的 Slint 视图类型。
//
// 字段与 aweft-model 的 `animation` 模块一一对应。
// 接线：权威数据在 `aweft-model::animation`（Action/FCurve/Keyframe/AnimData），
// 投影（`store/projections/animation.rs`）把 model 数据转换为本文件的视图结构，
// 由 CurveEditorState（store 自持 VecModels）持有并绑定 Slint。

// ===== 曲线编辑器（Graph Editor / FCurve） =====

// 贝塞尔控制柄：相对关键帧的偏移（对应 model 的 BezierHandle）
export struct SlintBezierHandle {
    time-offset: float,
    value-offset: float,
}

// 关键帧插值类型（对应 model 的 Interpolation）
export enum SlintInterpolation {
    bezier,
    linear,
    hold,
}

// 选中关键帧的插值聚合状态（供侧边栏显示）
export enum SlintInterpolationState {
    none,    // 无选中
    mixed,   // 选中关键帧插值不同
    bezier,
    linear,
    hold,
}

export enum SlintColorMode {
    auto-rainbow,
    user,
}

export enum SlintKeyframeDragMode {
    move,
    drag-out-handle,
}

export enum SlintHandleDragMode {
    free,
    aligned,
    symmetric,
}

// 单个关键帧（对应 model 的 Keyframe）
export struct SlintKeyframe {
    time: float,
    value: float,
    interpolation: SlintInterpolation,
    // bezier 插值时的控制柄（相对关键帧偏移；非 bezier 时忽略）
    handle-in: SlintBezierHandle,
    handle-out: SlintBezierHandle,
    // UI 选中态（Rust 侧维护）
    selected: bool,
}

// 一条 FCurve 通道（对应 model 的 FCurve + PropertyPath）
export struct SlintFCurveChannel {
    // 真实通道下标（压缩过滤视图里用于把显示行映射回真实索引）
    curve-index: int,
    // 属性路径显示名
    name: string,
    // 通道显示色
    color: color,
    // 用户设置的曲线颜色（颜色来源为“用户设置”时使用）
    user-color: color,
    // 曲线颜色来源
    color-mode: SlintColorMode,
    // 是否在曲线图中显示（眼睛）
    visible: bool,
    // 是否启用曲线修改器（扳手）
    modifier-enabled: bool,
    // 是否实际起作用（复选框；未激活时曲线弱化显示）
    active: bool,
    // 是否可编辑（锁）
    editable: bool,
    // UI 选中态（多选：点击曲线/列表行选中；Shift 区间、Ctrl 切换）
    selected: bool,
    keyframes: [SlintKeyframe],
}

// ===== 曲线渲染派生数据 =====

export enum SlintSegmentKind {
    bezier,
    linear,
    hold,
}

// 相邻两个关键帧之间的一段曲线（供 Path 逐段渲染）。
// 为简化 Slint 侧渲染，所有类型都用三次贝塞尔表示：
//  - bezier：直接使用两端的控制柄
//  - linear / hold：控制点取直线上 1/3、2/3 位置（退化贝塞尔 = 直线）
export struct SlintCurveSegment {
    // 所属通道下标
    curve-index: int,
    kind: SlintSegmentKind,
    color: color,
    // 起点关键帧（世界坐标：time, value）
    x0: float,
    y0: float,
    // 贝塞尔控制点（世界坐标）
    cx1: float,
    cy1: float,
    cx2: float,
    cy2: float,
    // 终点关键帧（世界坐标）
    x1: float,
    y1: float,
    // Hold 插值时的瞬变目标值：竖直虚线从 (x1, y1) 连接到 (x1, step-value)；
    // 其他插值类型忽略
    step-value: float,
}

// 贝塞尔控制柄标记（关键帧 → 控制点的一条线 + 端点圆点）
export struct SlintHandleMarker {
    curve-index: int,
    keyframe-index: int,
    // true = 入柄（handle-in），false = 出柄（handle-out）
    is-in: bool,
    color: color,
    // 关键帧（世界坐标）
    key-time: float,
    key-value: float,
    // 控制点（世界坐标）
    handle-time: float,
    handle-value: float,
    // 仅用于移动关键帧时的替换路径：被钳制手柄用有效控制点替换并高亮；
    // 拖手柄时“原手柄 + 钳制预览”走独立的 preview-handles 附加模型。
    preview: bool,
    // UI 选中态（框选/点击选中手柄；多选时拖拽同侧手柄按相同角度增量旋转）
    selected: bool,
}

// 摄影表连接线：两个关键帧之间为线性/常量插值时，在行内画一条线连接。
// 线性与常量在曲线编辑器中都是直线，用符号区分：
//   - 线性：实线；
//   - 常量：线 + 虚线。
export struct SlintDopeConnection {
    curve-index: int,
    // 压缩视图中的行号（摄影表画布行位置用）
    row-index: int,
    // 连接线起止时间（世界坐标，起 ≤ 止）
    x0: float,
    x1: float,
    color: color,
    // 常量插值（hold）：线 + 虚线
    is-hold: bool,
    // 通道眼睛可见（搜索匹配由“只生成匹配通道的连接”隐式处理）
    visible: bool,
}

// ===== NLA 编辑器 =====

// 片断类型（对应 model 的 StripType）
export enum SlintStripType {
    action,
    transition,
    meta,
}

// NLA 片断（对应 model 的 NlaStrip 的时间范围 + 显示属性）
export struct SlintNlaStrip {
    name: string,
    strip-type: SlintStripType,
    // 在轨道上的时间范围（秒）
    start: float,
    end: float,
    muted: bool,
    selected: bool,
    // 是否正在被拖拽（移动中换"移动颜色"）
    dragging: bool,
}

// NLA 轨道（对应 model 的 NlaTrack）
export struct SlintNlaTrack {
    name: string,
    // 轨道启用开关（右侧"启用"）
    enabled: bool,
    // 轨道锁定开关（右侧"锁"；锁定后不可编辑）
    locked: bool,
    strips: [SlintNlaStrip],
    // 是否为全局 Action 轨道（NLA 第一轨：显示当前编辑的 Action，1:1 时间，
    // 只能看不能编辑；渲染用 action-start/end，忽略 strips）
    is-action: bool,
    // 全局 Action 轨：当前 Action 是否有关键帧数据（空 Action 时"向下插入"按钮隐藏）
    has-data: bool,
    // 权威轨道下标（Rust 维护；搜索过滤视图行 → 权威轨道映射用）
    orig-index: int,
}

// 摄影表汇总条带上的关键帧标记：按整数毫秒时间聚合所有通道同一时间的关键帧。
// count = 该时间点上跨通道的关键帧总数。selected 为逐通道选中掩码
//（按摄影表过滤视图通道顺序，长度=count）：
//   - 堆叠关键帧（count<=5）：每层菱形对应一个通道，该层高亮 = 对应通道关键帧选中；
//   - 大关键帧（count>5）：仅当全部通道关键帧都选中时才高亮（all-selected）。
export struct SlintSummaryKeyframe {
    time: float,
    count: int,
    selected: [bool],
    // count>5 时大关键帧是否全部选中（Rust 端随掩码同步维护）
    all-selected: bool,
}

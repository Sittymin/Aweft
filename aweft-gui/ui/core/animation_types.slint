// 动画编辑器（曲线编辑器 + NLA 编辑器）的 Slint 视图类型。
//
// 字段与 aweft-model 的 `animation` 模块一一对应（UI 先行阶段，暂未接线 model）。
// 后续接入时，Rust 侧应把 model 的 FCurve/Keyframe/AnimData/NlaTrack/NlaStrip
// 转换为本文件的视图结构。

// ===== 曲线编辑器（Graph Editor / FCurve） =====

// 贝塞尔控制柄：相对关键帧的偏移（对应 model 的 BezierHandle）
export struct SlintBezierHandle {
    time-offset: float,
    value-offset: float,
}

// 关键帧插值类型（对应 model 的 Interpolation）
export enum SlintInterpolation {
    bezier,
    linear,
    hold,
}

// 单个关键帧（对应 model 的 Keyframe）
export struct SlintKeyframe {
    time: float,
    value: float,
    interpolation: SlintInterpolation,
    // bezier 插值时的控制柄（相对关键帧偏移；非 bezier 时忽略）
    handle-in: SlintBezierHandle,
    handle-out: SlintBezierHandle,
    // UI 选中态（Rust 侧维护）
    selected: bool,
}

// 一条 FCurve 通道（对应 model 的 FCurve + PropertyPath）
export struct SlintFCurveChannel {
    // 属性路径显示名
    name: string,
    // 通道显示色
    color: color,
    // 用户设置的曲线颜色（颜色来源为“用户设置”时使用）
    user-color: color,
    // 曲线颜色来源：0=自动彩虹，1=用户设置
    color-mode: int,
    // 是否在曲线图中显示（眼睛）
    visible: bool,
    // 是否启用曲线修改器（扳手）
    modifier-enabled: bool,
    // 是否实际起作用（复选框；未激活时曲线弱化显示）
    active: bool,
    // 是否可编辑（锁）
    editable: bool,
    // UI 选中态（多选：点击曲线/列表行选中；Shift 区间、Ctrl 切换）
    selected: bool,
    keyframes: [SlintKeyframe],
}

// ===== 曲线渲染派生数据 =====

export enum SlintSegmentKind {
    bezier,
    linear,
    hold,
}

// 相邻两个关键帧之间的一段曲线（供 Path 逐段渲染）。
// 为简化 Slint 侧渲染，所有类型都用三次贝塞尔表示：
//  - bezier：直接使用两端的控制柄
//  - linear / hold：控制点取直线上 1/3、2/3 位置（退化贝塞尔 = 直线）
export struct SlintCurveSegment {
    // 所属通道下标
    curve-index: int,
    kind: SlintSegmentKind,
    color: color,
    // 起点关键帧（世界坐标：time, value）
    x0: float,
    y0: float,
    // 贝塞尔控制点（世界坐标）
    cx1: float,
    cy1: float,
    cx2: float,
    cy2: float,
    // 终点关键帧（世界坐标）
    x1: float,
    y1: float,
    // Hold 插值时的瞬变目标值：竖直虚线从 (x1, y1) 连接到 (x1, step-value)；
    // 其他插值类型忽略
    step-value: float,
}

// 贝塞尔控制柄标记（关键帧 → 控制点的一条线 + 端点圆点）
export struct SlintHandleMarker {
    curve-index: int,
    keyframe-index: int,
    // true = 入柄（handle-in），false = 出柄（handle-out）
    is-in: bool,
    color: color,
    // 关键帧（世界坐标）
    key-time: float,
    key-value: float,
    // 控制点（世界坐标）
    handle-time: float,
    handle-value: float,
    // 是否处于“渲染期钳制”预览态：移动关键帧时被钳制的手柄用有效控制点替换并高亮，
    // 未钳制的手柄此字段为 false（显示原手柄）
    preview: bool,
}

// ===== NLA 编辑器 =====

// 片断类型（对应 model 的 StripType）
export enum SlintStripType {
    action,
    transition,
    meta,
}

// NLA 片断（对应 model 的 NlaStrip 的时间范围 + 显示属性）
export struct SlintNlaStrip {
    name: string,
    strip-type: SlintStripType,
    // 在轨道上的时间范围（秒）
    start: float,
    end: float,
    color: color,
    muted: bool,
    selected: bool,
}

// NLA 轨道（对应 model 的 NlaTrack）
export struct SlintNlaTrack {
    name: string,
    muted: bool,
    solo: bool,
    strips: [SlintNlaStrip],
}

// ===== 标尺刻度（Rust 侧派生） =====

export struct SlintRulerTick {
    value: float,
    label: string,
    major: bool,
}
